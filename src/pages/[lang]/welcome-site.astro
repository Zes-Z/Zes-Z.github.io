---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import type { Language } from '../../types';
import { renderMarkdown } from '../../utils/markdown';

export async function getStaticPaths() {
  return siteConfig.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

const page = await getEntry('pages', lang);
const html = (await renderMarkdown(page?.body ?? '')).html;
---

<BaseLayout lang={lang} title={page?.data.title ?? 'Welcome to this site!'}>
  <article class="welcome-site-page">
    <h1 class="welcome-site-title">{page?.data.title ?? 'Welcome to this site!'}</h1>
    <div class="prose welcomet-site-body" set:html={html} />
  </article>
</BaseLayout>

<style>
  .welcome-site-page {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    padding: clamp(1rem, 3vw, 2.5rem) 0;
  }
  .welcome-site-title {
    margin: 0 0 1.65rem;
    text-align: center;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 600;
  }
</style>

