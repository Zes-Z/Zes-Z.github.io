---
import SelfLayout from '../../../layouts/SelfLayout.astro';
import { siteConfig } from '../../../site.config';
import type { Language } from '../../../types';

export async function getStaticPaths() {
  return siteConfig.langs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as {
  lang: Language;
};
---

<SelfLayout
  lang={lang}
  title="About Zes"
  description="About Zes — Zes 的个人空间"
>

  <!-- 首页 -->
  <section
    id="home"
    class="self-section self-home"
  >
    <div class="self-home-inner">

      <div class="self-home-content">

        <p class="self-home-eyebrow">
          HELLO, I'M ZES
        </p>

        <h1 class="self-home-title">
          Zes
        </h1>

        <p class="self-home-description">
          
          一个正在研究语言、代码与世界的人。
        </p>

        <div class="self-home-buttons">

          <a
            href="https://zes4u.pages.dev/"
            class="self-button self-button--primary"
          >
            访问主站 →
          </a>

          <a
            href="#about"
            class="self-button self-button--secondary"
          >
            了解 Zes
          </a>

        </div>

      </div>

      <div class="self-home-visual">

        <div class="self-avatar-wrap">

          <div class="self-avatar-ring"></div>

          <div class="self-avatar-placeholder">
            <img
             src="/about zes.jpg"
             alt="Zes"
            />
          </div>

        </div>

      </div>

    </div>
  </section>






  <!-- 关于 -->
  <section
    id="about"
    class="self-section"
  >

    <div class="self-section-inner self-about-inner">

      <h3 class="self-section-title">
        <span class="emoji">🧙</span>
        关于 在时
      </h3>

      <p class="self-about-text">
        一些标签，这是了解我的最快方式。
        <br />
        当然，如果有机会我们可以一边走一边聊。
      </p>



      <div class="self-about-grid">

        <article class="self-info-card">
          <div class="self-info-card-icon">
            🧠
          </div>

          <h3>
            INTJ + 双鱼 + 完美主义
          </h3>

          <p>
            一个追求完美却又懒惰、焦躁且（有点）自律的三日坊主。
          </p>
        </article>

        <article class="self-info-card">
          <div class="self-info-card-icon">
            📚
          </div>

          <h3>
            Linguistics
          </h3>

          <p>
            自高等教育阶段起，以外语为专业。
            <br />
            知晓一些语言学，同时会一点哑巴英语和日语，以及一口不太流利的宿松话。
          </p>
        </article>

        <article class="self-info-card">
          <div class="self-info-card-icon">
            💻
          </div>

          <h3>
            Programming
          </h3>

          <p>
            Python、C++、SQL，
            以及各种正在折腾的东西。
          </p>
        </article>

      </div>

    </div>

  </section>






  <!-- 技能 -->
  <section
    id="skills"
    class="self-section"
  >

    <div class="self-section-inner self-skills-inner">

      <h3 class="self-section-title">
        <span class="emoji">🚀</span>
        我的 Skills
      </h3>

      <p class="self-section-subtitle">
        正在使用、学习以及不断折腾的技术。
      </p>

      <div class="self-skills-grid">

        <article class="self-skill-card">
          <div class="self-skill-icon">🐍</div>
          <h3>Python</h3>
          <p>NLP · 数据处理 · 科学计算</p>
        </article>


        <article class="self-skill-card">
          <div class="self-skill-icon">🗂️</div>
          <h3>PostgreSQL</h3>
          <p>Database 查增改删</p>
        </article>

        <article class="self-skill-card">
          <div class="self-skill-icon">🪢</div>
          <h3>Git</h3>
          <p>GitHub · Version Control</p>
        </article>

        <article class="self-skill-card">
          <div class="self-skill-icon">✨</div>
          <h3>Vibe Coding</h3>
          <p>使用 AI 做一些有趣的事/物</p>
        </article>

      </div>

    </div>

  </section>






  <!-- 作品 -->
  <section
    id="works"
    class="self-section"
  >

    <div class="self-section-inner self-works-inner">

      <h3 class="self-section-title">
        <span class="emoji">🛠️</span>
        我的作品
      </h3>

      <p class="self-section-subtitle">
        一些正在做、做过或者觉得有意思的东西。
      </p>

      <div class="self-works-grid">

        <a
          class="self-work-card"
          href="https://github.com/Zes-Z/QtCreator/tree/main/DailyUp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="self-work-icon">
            📝
          </div>

          <h3>
            DailyUp
          </h3>

          <p>
            一个精简的每日打卡记录工具。
          </p>

          <span class="self-work-link">
            → GitHub Repositories
          </span>
        </a>


        <a
          class="self-work-card"
          href="https://zes4u.pages.dev/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="self-work-icon">
            🌐
          </div>

          <h3>
            Zes4U
          </h3>

          <p>
            我的个人网站、博客以及知识空间。
          </p>

          <span class="self-work-link">
            → GitHub Repositories
          </span>
        </a>


        <a
          class="self-work-card"
          href="https://github.com/Zes-Z/QtCreator/tree/main/One%20more%20qtp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="self-work-icon">
            🗂️
          </div>

          <h3>
            Zesbks
          </h3>

          <p>
            有趣的文档阅读与管理工具。
          </p>

          <span class="self-work-link">
            → Github Repositories
          </span>
        </a>

      </div>

    </div>

  </section>






  <section
    id="messagewall"
    class="self-section"
  >
  <div class="self-section-inner">
    <h2 class="self-section-title">
      <span class="emoji">💭</span>
      留言墙
    </h2>

    <p class="self-section-subtitle">
      留下一句话，或者分享一些想说的话。
    </p>

  </div>





</section>





  <!-- Footer -->
  <footer class="self-footer">

    <p>
      © {new Date().getFullYear()} Zes.
      It's never late to start.
    </p>

  </footer>

</SelfLayout>