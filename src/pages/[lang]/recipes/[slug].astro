---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import AdjacentNav from '../../../components/AdjacentNav.astro';
import { siteConfig } from '../../../site.config';
import type { Language } from '../../../types';
import { recipeCover, recipeImages } from '../../../utils/recipes';
import { withBase } from '../../../utils/paths';
import { renderMarkdown } from '../../../utils/markdown';

export async function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of siteConfig.langs) {
    const items = await getCollection('recipes', (r) => r.id.startsWith(`${lang}/`));
    for (const item of items) {
      if (item.data.draft) continue;
      paths.push({ params: { lang, slug: item.id.slice(lang.length + 1) } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const recipe = (await getCollection('recipes')).find((r) => r.id === `${lang}/${slug}`);

if (!recipe) {
  return Astro.redirect(withBase(`/${lang}/recipes`));
}

const title = recipe.data.title;
const description = recipe.data.description ?? '';
const categories = recipe.data.categories ?? '';
const date = recipe.data.pubDate ?? new Date(0);
const dateText = `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`;
const { html: bodyHtml, headings } = await renderMarkdown(recipe.body ?? '');
const images = await recipeImages(slug);
const backHref = withBase(`/${lang}/recipes`);
const hasToc = headings.length > 0;

// 同语言食谱按发布时间正序(旧→新):时间上的上一篇放左侧,下一篇放右侧
const orderedRecipes = (await getCollection('recipes', (r) => r.id.startsWith(`${lang}/`)))
  .filter((r) => !r.data.draft)
  .sort((a, b) => (a.data.pubDate?.getTime() ?? 0) - (b.data.pubDate?.getTime() ?? 0));
const currentIndex = orderedRecipes.findIndex((r) => r.id === `${lang}/${slug}`);
const prevRecipe = currentIndex > 0 ? orderedRecipes[currentIndex - 1] : undefined;
const nextRecipe = currentIndex >= 0 && currentIndex < orderedRecipes.length - 1 ? orderedRecipes[currentIndex + 1] : undefined;

async function adjacentRecipeCard(r: Awaited<ReturnType<typeof getCollection<'recipes'>>>[number]) {
  const rSlug = r.id.slice(lang.length + 1);
  const cover = await recipeCover(rSlug);
  const pub = r.data.pubDate ?? new Date(0);
  return {
    href: withBase(`/${lang}/recipes/${rSlug}`),
    title: r.data.title,
    image: cover?.src,
    ratio: cover?.ratio,
    date: `${pub.getFullYear()}/${pub.getMonth() + 1}/${pub.getDate()}`,
    tags: r.data.tags ?? [],
    category: r.data.categories ?? '',
  };
}
const prevCard = prevRecipe ? await adjacentRecipeCard(prevRecipe) : undefined;
const nextCard = nextRecipe ? await adjacentRecipeCard(nextRecipe) : undefined;
---

<BaseLayout lang={lang} title={title} description={description || undefined}>
  <div class="reading-progress" aria-hidden="true">
    <span data-progress-bar></span>
  </div>

  <div class:list={['post-layout', { 'has-toc': hasToc }]}>
    {hasToc && <TableOfContents {lang} {headings} />}

    <article class="post">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        {description && <p class="post-description">{description}</p>}
        <div class="post-meta">
          <time datetime={date.toISOString()}>{dateText}</time>
          {categories && <a class="chip chip-link" href={`${backHref}?category=${encodeURIComponent(categories)}`}>{categories}</a>}
          {recipe.data.tags?.map((tagName) => <span class="chip chip--plain"># {tagName}</span>)}
        </div>
      </header>

      <div class="prose post-body" set:html={bodyHtml} />

      {
        images.length > 0 && (
          <div class="recipe-detail-masonry">
            {
              images.map((p) => (
                <img
                  class:list={['recipe-photo', { 'is-landscape': p.landscape }]}
                  src={p.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ))
            }
          </div>
        )
      }

      <footer class="post-footer">
        <AdjacentNav prev={prevCard} next={nextCard} />
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  // 顶部细进度条:按阅读进度填充
  const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const update = () => {
    if (!bar) return;
    const root = document.documentElement;
    const total = root.scrollHeight - window.innerHeight;
    bar.style.width = total > 0 ? `${Math.min(100, (window.scrollY / total) * 100)}%` : '0%';
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }
  .reading-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--sky);
    border-radius: 0 2px 2px 0;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 780px);
    gap: 2rem;
    justify-content: center;
    align-items: start;
  }
  .post-layout.has-toc {
    grid-template-columns: 220px minmax(0, 780px);
    gap: 2.5rem;
    padding-left: 2.5rem;
  }

  .post {
    max-width: 780px;
    padding: clamp(1rem, 3vw, 2.5rem) 0;
  }

  .post-title {
    margin: 0 0 0.7rem;
    font-size: clamp(1.45rem, 3.4vw, 2rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .post-description {
    margin: 0 0 1rem;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .post-meta time {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .post-meta .chip-link {
    text-decoration: none;
  }
  .post-meta .chip-link:hover {
    background: color-mix(in srgb, var(--sky) 24%, transparent);
    color: var(--hover);
  }

  .post-body {
    margin-top: 1.4rem;
  }

  .recipe-detail-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: 14px;
    align-items: start;
    margin-top: 1.6rem;
  }
  .recipe-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    /* 原图较大:让浏览器跳过屏幕外图片的解码与绘制 */
    content-visibility: auto;
    contain-intrinsic-size: auto 360px;
  }
  .recipe-photo.is-landscape {
    grid-column: span 2;
  }
  @media (max-width: 900px) {
    .recipe-detail-masonry {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .recipe-detail-masonry {
      grid-template-columns: 1fr;
    }
    .recipe-photo.is-landscape {
      grid-column: span 1;
    }
  }

  .post-footer {
    margin-top: 2.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 1024px) {
    .post-layout,
    .post-layout.has-toc {
      grid-template-columns: minmax(0, 780px);
      padding-left: 0;
    }
    .toc {
      display: none;
    }
  }
</style>