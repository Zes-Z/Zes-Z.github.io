---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import AdjacentNav from '../../../components/AdjacentNav.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../../../SiteConfig';
import type { Language } from '../../../types';
import { getPublishedPosts, slugOf } from '../../../utils/posts';
import { renderMarkdown } from '../../../utils/markdown';
import { archiveCategoryHref, assetHref, postHref } from '../../../utils/paths';
import { postImageCandidates, resolvePostAsset } from '../../../utils/images';
import { getImage } from 'astro:assets';

/* =========================================================
 * Static paths
 * ========================================================= */

export async function getStaticPaths() {
  const paths: {
    params: {
      lang: string;
      slug: string;
    };
  }[] = [];

  for (const lang of siteConfig.langs) {
    const posts = await getCollection(
      'posts',
      (post) =>
        post.id.startsWith(`${lang}/`),
    );

    for (const post of posts) {
      if (post.data.draft) {
        continue;
      }

      paths.push({
        params: {
          lang,
          slug: slugOf(post, lang),
        },
      });
    }
  }

  return paths;
}

/* =========================================================
 * Current post
 * ========================================================= */

const {
  lang,
  slug,
} = Astro.params as {
  lang: Language;
  slug: string;
};

const post = (
  await getCollection('posts')
).find(
  (p) =>
    p.id === `${lang}/${slug}`,
);

if (
  !post ||
  post.data.draft
) {
  return Astro.redirect(
    `/`,
  );
}

const title = post.data.title;
const description =
  post.data.description ?? '';

const date =
  post.data.pubDate ??
  new Date(0);

const dateText =
  `${date.getFullYear()}/${
    date.getMonth() + 1
  }/${date.getDate()}`;

/* =========================================================
 * Resolve Markdown links
 * ========================================================= */


function resolvePostLink(
  url: string,
): string | undefined {
  let cleanUrl = url
    .replaceAll('\\', '/')
    .replaceAll('{lang}', lang);

  /*
   * Separate query string / hash from the path.
   *
   * Example:
   *
   *   child/zh.md#foo
   *
   * becomes:
   *
   *   path = child/zh.md
   *   suffix = #foo
   */
  const suffixMatch =
    /([?#].*)$/.exec(cleanUrl);

  const suffix =
    suffixMatch?.[1] ?? '';

  if (suffix) {
    cleanUrl =
      cleanUrl.slice(
        0,
        -suffix.length,
      );
  }

  /*
   * Only Markdown content links are
   * transformed here.
   */
  if (
    !cleanUrl.endsWith('.md')
  ) {
    return undefined;
  }

  /*
   * Remove leading ./ segments.
   *
   *   ./foo/zh.md
   *   ↓
   *   foo/zh.md
   */
  cleanUrl =
    cleanUrl.replace(
      /^(\.\/)+/,
      '',
    );

  /*
   * Current Markdown file is:
   *
   *   <slug>/<lang>.md

   */
  const baseParts =
    slug
      .split('/')
      .filter(Boolean);

  /*
   * Parse the relative target.
   */
  const targetParts =
    cleanUrl
      .split('/')
      .filter(Boolean);

  /*
   * Resolve "." and ".." manually.
   */
  const resolvedParts = [
    ...baseParts,
  ];

  for (
    const part of targetParts
  ) {
    if (
      part === '.' ||
      part === ''
    ) {
      continue;
    }

    if (part === '..') {
      /*
       * Do not allow a Markdown link
       * to escape the posts root.
       */
      if (
        resolvedParts.length === 0
      ) {
        return undefined;
      }

      resolvedParts.pop();
      continue;
    }

    resolvedParts.push(part);
  }

  /*
   * The final filename is normally:
   *
   *   zh.md
   *   en.md
   *   ja.md
   *
   * Remove the language filename.
   */
  const last =
    resolvedParts.at(-1);

  if (
    last === 'zh.md' ||
    last === 'en.md' ||
    last === 'ja.md'
  ) {
    resolvedParts.pop();
  } else {
    /*
     * A Markdown link that ends with an
     * unexpected filename is not treated
     * as a post link.
     */
    return undefined;
  }

  if (
    resolvedParts.length === 0
  ) {
    return undefined;
  }

  const targetSlug =
    resolvedParts.join('/');

  return (
    postHref(
      lang,
      targetSlug,
    ) + suffix
  );
}

/* =========================================================
 * Render Markdown
 * ========================================================= */

const {
  html: bodyHtml,
  headings,
} =
  await renderMarkdown(
    post.body ?? '',
    {
      /*
       * Relative image resolver.
       */
      resolveImage: async (
        url,
      ) => {
        const meta =
          await resolvePostAsset(
            slug,
            url,
          );

        if (!meta) {
          return undefined;
        }

        const original = assetHref(meta.src);
        const openLabel = lang === 'zh' ? '点击查看原图' : lang === 'ja' ? 'クリックして元画像を表示' : 'Open original image';
        try {
          const preview = await getImage({
            src: meta,
            width: Math.min(meta.width || 1400, 1400),
            format: 'avif',
            quality: 68,
          });
          return {
            src: preview.src,
            original,
            openLabel,
            width: preview.attributes.width,
            height: preview.attributes.height,
          };
        } catch {
          return { src: original, original, openLabel, width: meta.width, height: meta.height };
        }
      },

      /*
       * Relative Markdown link resolver.
       */
      resolveLink:
        resolvePostLink,
    },
  );

/* =========================================================
 * Adjacent navigation
 * ========================================================= */

/*
 * Only published top-level posts are returned
 * by getPublishedPosts().
 *
 * Therefore subpages do not appear in
 * previous/next navigation.
 */
const orderedPosts =
  (
    await getPublishedPosts(lang)
  ).sort(
    (a, b) =>
      (
        a.data.pubDate?.getTime() ??
        0
      ) -
      (
        b.data.pubDate?.getTime() ??
        0
      ),
  );

const currentIndex =
  orderedPosts.findIndex(
    (p) =>
      p.id ===
      `${lang}/${slug}`,
  );

const prevPost =
  currentIndex > 0
    ? orderedPosts[
        currentIndex - 1
      ]
    : undefined;

const nextPost =
  currentIndex >= 0 &&
  currentIndex <
    orderedPosts.length - 1
    ? orderedPosts[
        currentIndex + 1
      ]
    : undefined;

async function adjacentCard(
  post: Awaited<
    ReturnType<
      typeof getPublishedPosts
    >
  >[number],
) {
  const pub =
    post.data.pubDate ??
    new Date(0);

  const cover = await postImageCandidates(
    slugOf(post, lang),
    post.data.postImage,
    [480, 800, 1200, 1600],
    800,
  );

  return {
    href: postHref(
      lang,
      slugOf(post, lang),
    ),

    title:
      post.data.title,

    date:
      `${pub.getFullYear()}/${
        pub.getMonth() + 1
      }/${pub.getDate()}`,

    datetime: pub.toISOString().slice(0, 10),

    category:
      post.data.category,

    image: cover?.src,
    imageSrcset: cover?.srcset,
  };
}

const prevCard =
  prevPost
    ? await adjacentCard(
        prevPost,
      )
    : undefined;

const nextCard =
  nextPost
    ? await adjacentCard(
        nextPost,
      )
    : undefined;

/*
 * No headings → no TOC column.
 */
const hasToc =
  headings.length > 0;
---

<BaseLayout
  lang={lang}
  title={title}
  description={
    description || undefined
  }
>
  <div
    class="reading-progress"
    aria-hidden="true"
  >
    <span
      data-progress-bar
    ></span>
  </div>

  <div
    class:list={[
      'post-layout',
      { 'has-toc': hasToc },
    ]}
  >
    {
      hasToc && (
        <TableOfContents
          {lang}
          {headings}
        />
      )
    }

    <article class="post">
      <header class="post-header">
        <h1 class="post-title">
          {title}
        </h1>

        {
          description && (
            <p class="post-description">
              {description}
            </p>
          )
        }

        <div class="post-meta">
          <time
            datetime={
              date.toISOString()
            }
          >
            {dateText}
          </time>

          <a
            class="chip chip-link"
            href={archiveCategoryHref(
              lang,
              post.data.category,
            )}
          >
            {post.data.category}
          </a>

          {
            post.data.tag?.map(
              (tagName) => (
                <span class="chip chip--plain">
                  # {tagName}
                </span>
              ),
            )
          }
        </div>
      </header>

      <div
        class="prose post-body"
        set:html={bodyHtml}
      />

      <dialog
        class="post-image-dialog"
        data-post-image-dialog
        aria-label={lang === 'zh' ? '原图' : lang === 'ja' ? '元画像' : 'Original image'}
      >
        <button
          class="post-image-close"
          type="button"
          data-post-image-close
          aria-label={lang === 'zh' ? '关闭原图' : lang === 'ja' ? '画像を閉じる' : 'Close image'}
        >×</button>
        <img data-post-image-full alt="" />
      </dialog>

      {(prevCard || nextCard) && (
        <footer class="post-footer">
          <AdjacentNav
            {lang}
            prev={prevCard}
            next={nextCard}
          />
        </footer>
      )}
    </article>
  </div>
</BaseLayout>

<script>
  // 顶部细进度条:按阅读进度填充。bar 每次从当前 DOM 重新查询,
  // 兼容 ClientRouter 的 SPA 页面切换。
  const update = () => {
    const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
    if (!bar) return;

    const root = document.documentElement;
    const total = root.scrollHeight - window.innerHeight;

    bar.style.width =
      total > 0
        ? `${Math.min(100, (window.scrollY / total) * 100)}%`
        : '0%';
  };

  window.addEventListener('scroll', update, { passive: true });
  update();
  document.addEventListener('astro:page-load', update);

  const bindPostImages = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-post-image-dialog]');
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';
    const full = dialog.querySelector<HTMLImageElement>('[data-post-image-full]');
    if (!full) return;
    let request = 0;

    const open = (thumb: HTMLImageElement) => {
      const original = thumb.dataset.postOriginal;
      if (!original) return;
      const current = ++request;
      full.src = thumb.currentSrc || thumb.src;
      full.alt = thumb.alt;
      dialog.showModal();
      const image = new Image();
      image.src = original;
      void image.decode().then(() => {
        if (dialog.open && request === current) full.src = original;
      }).catch(() => {});
    };

    dialog.addEventListener('close', () => { request += 1; });
    dialog.querySelector('[data-post-image-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.querySelectorAll<HTMLImageElement>('.post-body img[data-post-original]').forEach((thumb) => {
      thumb.addEventListener('click', () => open(thumb));
      thumb.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        open(thumb);
      });
    });
  };
  bindPostImages();
  document.addEventListener('astro:page-load', bindPostImages);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--sky);
    border-radius: 0 2px 2px 0;
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 780px);
    gap: 2rem;
    justify-content: center;
    align-items: start;
  }

  .post-layout.has-toc {
    grid-template-columns:
      220px
      minmax(0, 780px);
    gap: 2.5rem;
    padding-left: 2.5rem;
  }

  .post {
    max-width: 780px;
    padding:
      clamp(1rem, 3vw, 2.5rem)
      0;
  }

  .post-title {
    margin: 0 0 0.7rem;
    font-size:
      clamp(1.45rem, 3.4vw, 2rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .post-description {
    margin: 0 0 1rem;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 1.1rem;
    border-bottom:
      1px solid var(--border);
  }

  .post-meta time {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .post-meta .chip-link {
    text-decoration: none;
  }

  .post-meta .chip-link:hover {
    background:
      color-mix(
        in srgb,
        var(--sky) 24%,
        transparent
      );
    color: var(--hover);
  }

  .post-body {
    margin-top: 1.4rem;
  }

  .post-body :global(img[data-post-original]) {
    cursor: zoom-in;
  }

  .post-body :global(img[data-post-original]:focus-visible) {
    outline: 3px solid var(--sky);
    outline-offset: 4px;
  }

  .post-image-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 1.5rem;
    border: 0;
    background: rgba(0, 0, 0, 0.94);
    overflow: hidden;
  }

  .post-image-dialog[open] {
    display: grid;
    place-items: center;
  }

  .post-image-dialog::backdrop {
    background: rgba(0, 0, 0, 0.94);
  }

  .post-image-dialog img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .post-image-close {
    position: fixed;
    top: 0.7rem;
    right: 1rem;
    z-index: 1;
    border: 0;
    background: transparent;
    color: white;
    font-size: 2.2rem;
    cursor: pointer;
  }

  .post-footer {
    margin-top: 2.6rem;
    padding-top: 1.2rem;
    border-top:
      1px solid var(--border);
  }

  @media (max-width: 1024px) {
    .post-layout,
    .post-layout.has-toc {
      grid-template-columns:
        minmax(0, 780px);
      padding-left: 0;
    }

    .toc {
      display: none;
    }
  }
</style>
