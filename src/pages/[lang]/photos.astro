---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryWall from '../../components/GalleryWall.astro';
import { siteConfig } from '../../site.config';
import { t } from '../../i18n';
import type { Language } from '../../types';
import type { GalleryWallItem, Photo } from '../../utils/photos';
import {
  photoHref,
  photosPhotos,
  photoViewTransitionName,
  portfolioCover,
  portfolioHref,
  portfolioPhotos,
} from '../../utils/photos';

export async function getStaticPaths() {
  return siteConfig.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

const photos = await photosPhotos();

/** Cover-less portfolios still get a card, with a quiet gradient placeholder. */
const PLACEHOLDER =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800">' +
      '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">' +
      '<stop offset="0" stop-color="#2a2f3a"/>' +
      '<stop offset="1" stop-color="#1f232c"/>' +
      '</linearGradient></defs>' +
      '<rect width="1200" height="800" fill="url(#g)"/>' +
      '</svg>'
  );
const placeholderPhoto: Photo = {
  src: PLACEHOLDER,
  thumb: { src: PLACEHOLDER, width: 1200, height: 800 },
  large: { src: PLACEHOLDER, width: 1200, height: 800 },
  width: 1200,
  height: 800,
  landscape: true,
  orientation: 'landscape',
  ratio: '3 / 2',
  slug: '',
  title: '',
  filename: '',
};

const portfolios = await Promise.all(
  (await getCollection('portfolios', (p) => p.id.startsWith(`${lang}/`))).map(
    async (p) => {
      const slug = p.id.slice(lang.length + 1);
      const cover = await portfolioCover(slug);
      return {
        slug,
        href: portfolioHref(lang, slug),
        title: p.data.title,
        cover,
        count: (await portfolioPhotos(slug)).length,
      };
    }
  )
);

const portfolioItems: GalleryWallItem[] = portfolios.map((item) => ({
  href: item.href,
  photo: item.cover ?? placeholderPhoto,
  title: item.title,
  subtitle: t(lang, 'photos.count').replace('{n}', String(item.count)),
}));

const photoItems: GalleryWallItem[] = photos.map((photo) => ({
  href: photoHref(lang, photo),
  photo,
  subtitle: t(lang, 'photos.category'),
  transitionName: photoViewTransitionName(photo),
}));

const tabs = [
  { id: 'photos', label: t(lang, 'photos.photos') },
  { id: 'portfolio', label: t(lang, 'photos.portfolio') },
  { id: 'coming', label: t(lang, 'photos.coming') },
];
---

<BaseLayout lang={lang} title={t(lang, 'nav.photos')}>
  <div class="photos-page">
    <div class="photos-tabs" role="tablist">
      {
        tabs.map((tab, index) => (
          <button
            class:list={['photos-tab', { 'is-active': index === 0 }]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`photos-panel-${tab.id}`}
            data-photos-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <!-- 1. 相册墙 -->
    <section
      class="photos-view is-active"
      id="photos-panel-photos"
      role="tabpanel"
      data-photos-view="photos"
    >
      {
        photoItems.length > 0 ? (
          <GalleryWall
            items={photoItems}
            eagerCount={6}
            ariaLabel={t(lang, 'photos.photos')}
          />
        ) : (
          <p class="photos-empty">{t(lang, 'photos.empty')}</p>
        )
      }
    </section>

    <!-- 2. 作品集 -->
    <section
      class="photos-view"
      id="photos-panel-portfolio"
      role="tabpanel"
      data-photos-view="portfolio"
    >
      {
        portfolioItems.length > 0 ? (
          <GalleryWall
            items={portfolioItems}
            eagerCount={4}
            ariaLabel={t(lang, 'photos.portfolio')}
          />
        ) : (
          <p class="photos-empty">{t(lang, 'photos.empty')}</p>
        )
      }
    </section>

    <!-- 3. 暂时保留 -->
    <section
      class="photos-view"
      id="photos-panel-coming"
      role="tabpanel"
      data-photos-view="coming"
    >
      <div class="photos-coming">
        <p class="photos-coming-title">{t(lang, 'photos.coming')}</p>
        <p class="photos-coming-desc">{t(lang, 'photos.comingDesc')}</p>
      </div>
    </section>

    <script is:inline>
    // 类别切换:点击标签切换对应板块。
    // 优先级:URL ?tab= → 返回(back_forward)时的 sessionStorage → 默认"所有"。
    // 使用内联脚本在解析时立即激活,避免先闪一下"所有"标签,
    // 也让跨文档 View Transition 能在新页面快照前找到目标缩略图。
    (() => {
      const STORAGE_KEY = 'zest-photos-tab';
      const VALID = new Set(['photos', 'portfolio', 'coming']);
      const tabs = Array.from(document.querySelectorAll('[data-photos-tab]'));
      const views = Array.from(document.querySelectorAll('[data-photos-view]'));

      const activate = (id) => {
        tabs.forEach((b) => {
          const active = b.dataset.photosTab === id;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        views.forEach((view) => {
          view.classList.toggle('is-active', view.dataset.photosView === id);
        });
      };

      const navEntry =
        performance.getEntriesByType &&
        performance.getEntriesByType('navigation')[0];
      const navType = navEntry && navEntry.type;
      const fromQuery = new URLSearchParams(window.location.search).get('tab');
      let saved = null;
      try {
        saved = sessionStorage.getItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
      const hasSaved = Boolean(saved) && VALID.has(saved);
      const initial =
        fromQuery && VALID.has(fromQuery)
          ? fromQuery
          : navType === 'back_forward' && hasSaved
            ? saved
            : 'photos';
      activate(initial);

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.dataset.photosTab || '';
          if (!VALID.has(id)) return;
          activate(id);
          try {
            sessionStorage.setItem(STORAGE_KEY, id);
            const url = new URL(window.location.href);
            url.searchParams.set('tab', id);
            window.history.replaceState(window.history.state, '', url);
          } catch {
            /* ignore */
          }
        });
      });
    })();
    </script>

  </div>
</BaseLayout>


<style>
  .photos-page {
    max-width: 1080px;
    margin: 1.5rem auto 0;
  }

  /* 标签行:居中,仿归档"类别"胶囊 */
  .photos-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.6rem;
  }

  .photos-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .photos-tab:hover {
    border-color: var(--hover);
    color: var(--hover);
    background: var(--surface-2);
  }
  .photos-tab.is-active {
    background: color-mix(in srgb, var(--sky) 14%, transparent);
    border-color: var(--sky);
    color: var(--sky);
    font-weight: 600;
  }

  .photos-view {
    display: none;
  }
  .photos-view.is-active {
    display: block;
  }

  .photos-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-faint);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  /* 暂时保留 */
  .photos-coming {
    padding: 4rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    color: var(--text-soft);
  }
  .photos-coming-title {
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text);
  }
  .photos-coming-desc {
    margin: 0;
    color: var(--text-faint);
  }
</style>
