---
import AlbumLayout from '../../../../layouts/AlbumLayout.astro';
import { siteConfig } from '../../../../site.config';
import type { Language } from '../../../../types';
import { getAlbumHomeItems } from '../../../../utils/album';

export async function getStaticPaths() {
  return siteConfig.langs.flatMap((lang) =>
    getAlbumHomeItems(lang)
      .filter((item) => 'count' in item)
      .map((item) => ({ params: { lang, portfolio: item.id }, props: { title: item.title } })),
  );
}

const { lang } = Astro.params as { lang: Language };
const { title } = Astro.props as { title: string };
const { portfolio } = Astro.params as { portfolio: string };
---

<AlbumLayout lang={lang} title={title} portfolioId={portfolio} />
