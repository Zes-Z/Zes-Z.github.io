---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryWall from '../../../components/GalleryWall.astro';
import { siteConfig } from '../../../site.config';
import { t } from '../../../i18n';
import type { Language } from '../../../types';
import type { GalleryWallItem } from '../../../utils/photos';
import {
  photoHref,
  photoViewTransitionName,
  portfolioPhotos,
} from '../../../utils/photos';
import { withBase } from '../../../utils/paths';
import { renderMarkdown } from '../../../utils/markdown';

export async function getStaticPaths() {
  const paths: { params: { lang: string; slug: string } }[] = [];
  for (const lang of siteConfig.langs) {
    const items = await getCollection('portfolios', (p) =>
      p.id.startsWith(`${lang}/`)
    );
    for (const item of items) {
      paths.push({ params: { lang, slug: item.id.slice(lang.length + 1) } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Language; slug: string };
const item = (await getCollection('portfolios')).find(
  (p) => p.id === `${lang}/${slug}`
);

if (!item) {
  return Astro.redirect(withBase(`/${lang}/photos?tab=portfolio`));
}

const title = item.data.title;
const description = item.data.description ?? '';
const { html: bodyHtml } = await renderMarkdown(item.body ?? '');
const photos = await portfolioPhotos(slug);

const items: GalleryWallItem[] = photos.map((photo) => ({
  href: photoHref(lang, photo),
  photo,
  subtitle: t(lang, 'photos.category'),
  transitionName: photoViewTransitionName(photo),
}));

const countLabel = t(lang, 'photos.count').replace('{n}', String(photos.length));
const backHref = withBase(`/${lang}/photos?tab=portfolio`);
---

<BaseLayout lang={lang} title={title} description={description || undefined}>
  <div class="portfolio-detail">
    <button
      type="button"
      class="portfolio-back"
      data-history-back
      data-fallback={backHref}
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M12.5 4.5 7 10l5.5 5.5"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t(lang, 'photos.back')}
    </button>

    <header class="portfolio-head">
      <h1 class="portfolio-detail-title">{title}</h1>
      <p class="portfolio-count-label">{countLabel}</p>
      {description && <p class="portfolio-detail-desc">{description}</p>}
    </header>

    {bodyHtml && <div class="prose portfolio-detail-body" set:html={bodyHtml} />}

    {
      items.length > 0 ? (
        <GalleryWall
          items={items}
          eagerCount={6}
          ariaLabel={title}
        />
      ) : (
        <p class="photos-empty">{t(lang, 'photos.empty')}</p>
      )
    }

  </div>
</BaseLayout>

<style>
  .portfolio-detail {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.4rem 0 3rem;
  }

  .portfolio-back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 1.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--text-soft);
    font-size: 0.92rem;
    cursor: pointer;
    transition: color var(--transition-fast);
  }
  .portfolio-back svg {
    width: 20px;
    height: 20px;
    flex: none;
  }
  .portfolio-back:hover {
    color: var(--hover);
  }

  .portfolio-head {
    margin-bottom: 1.5rem;
  }

  .portfolio-detail-title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .portfolio-count-label {
    margin: 0 0 0.9rem;
    color: var(--text-faint);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .portfolio-detail-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.75;
  }

  .portfolio-detail-body {
    margin: 0.9rem 0 2rem;
  }

  .photos-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-faint);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }
</style>
