---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import { t } from '../../i18n';
import type { Language } from '../../types';
import { recipeCover } from '../../utils/recipes';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  return siteConfig.langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };

/** 固定分类(来源:site.config.ts,与 `pnpm newreci` 共用同一份数据)。 */
const RECIPE_CATEGORIES = siteConfig.recipeCategories;

const recipes = await Promise.all(
  (await getCollection('recipes', (r) => r.id.startsWith(`${lang}/`)))
    .filter((r) => !r.data.draft)
    .map(async (r) => {
      const slug = r.id.slice(lang.length + 1);
      const date = r.data.pubDate ?? new Date(0);
      return {
        id: r.id,
        href: withBase(`/${lang}/recipes/${slug}`),
        title: r.data.title,
        description: r.data.description ?? '',
        categories: r.data.categories ?? '',
        tags: r.data.tags ?? [],
        date: `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`,
        cover: await recipeCover(slug),
      };
    })
);

const allCount = recipes.length;
const categoryCounts = new Map<string, number>();
for (const r of recipes) {
  if (r.categories) categoryCounts.set(r.categories, (categoryCounts.get(r.categories) ?? 0) + 1);
}
---

<BaseLayout lang={lang} title={t(lang, 'nav.recipe')}>
  <div class="recipes-page" data-recipes-page>
    <div class="recipes-categories" role="group" aria-label={t(lang, 'archive.categories')}>
      <a class="category-pill" data-category="" href={withBase(`/${lang}/recipes`)}>
        <span>{t(lang, 'archive.all')}</span>
        <span class="filter-count">{allCount}</span>
      </a>
      {
        RECIPE_CATEGORIES.map((cat) => (
          <a class="category-pill" data-category={cat} href={`${withBase(`/${lang}/recipes`)}?category=${encodeURIComponent(cat)}`}>
            <span>{cat}</span>
            <span class="filter-count">{categoryCounts.get(cat) ?? 0}</span>
          </a>
        ))
      }
    </div>

    {
      recipes.length > 0 ? (
        <div class="recipes-masonry" data-recipes-masonry>
          {
            recipes.map((r, index) => (
              <a
                class="recipe-card"
                href={r.href}
                data-categories={r.categories}
                aria-label={r.title}
              >
                <span class="recipe-media">
                  {r.cover ? (
                    <img
                      class="recipe-cover"
                      src={r.cover.thumb.src}
                      width={r.cover.thumb.width}
                      height={r.cover.thumb.height}
                      alt={r.title}
                      loading={index < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    <span class="recipe-fallback"></span>
                  )}
                </span>
                <span class="recipe-veil"></span>
                <span class="recipe-body">
                  <time class="recipe-date">{r.date}</time>
                  <span class="recipe-title">{r.title}</span>
                  {r.tags.length > 0 && (
                    <span class="recipe-chips">
                      {r.tags.map((tag) => <span class="chip">{tag}</span>)}
                    </span>
                  )}
                  {r.description && <span class="recipe-desc">{r.description}</span>}
                </span>
              </a>
            ))
          }
        </div>
      ) : (
        <p class="recipes-empty">{t(lang, 'photos.empty')}</p>
      )
    }
  </div>
</BaseLayout>

<script>
  // 分类筛选:纯 CSS columns 会自动重排,无需 JS 计算位置。
  function init() {
    const page = document.querySelector<HTMLElement>('[data-recipes-page]');
    if (!page || page.dataset.ready === 'true') return;
    page.dataset.ready = 'true';
    const pills = [...page.querySelectorAll<HTMLAnchorElement>('[data-category]')];
    const cards = [...page.querySelectorAll<HTMLElement>('[data-recipes-masonry] .recipe-card')];

    const apply = (cat: string) => {
      pills.forEach((b) => {
        const active = b.dataset.category === cat;
        b.classList.toggle('is-active', active);
      });
      cards.forEach((card) => {
        card.hidden = cat !== '' && card.dataset.categories !== cat;
      });
    };

    const category = new URLSearchParams(window.location.search).get('category') ?? '';
    apply(category);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .recipes-page {
    max-width: 1080px;
    margin: 1.5rem auto 0;
    padding-bottom: 2rem;
  }

  /* 分类胶囊(居中,仿归档) */
  .recipes-categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.5rem;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .category-pill:hover {
    border-color: var(--hover);
    color: var(--hover);
    background: var(--surface-2);
  }
  .category-pill.is-active {
    background: color-mix(in srgb, var(--sky) 14%, transparent);
    border-color: var(--sky);
    color: var(--sky);
    font-weight: 600;
  }
  .category-pill .filter-count {
    background: transparent;
    color: var(--text-faint);
    font-size: 0.78rem;
    line-height: 1;
  }
  .category-pill.is-active .filter-count {
    color: var(--sky);
  }

  /* 自然比例 CSS columns,与相册墙同一套视觉语言 */
  .recipes-masonry {
    columns: 1;
    column-gap: 1.25rem;
  }

  .recipe-card[hidden] {
    display: none !important;
  }

  .recipe-card {
    position: relative;
    display: block;
    overflow: hidden;
    margin: 0 0 1.25rem;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    border-radius: var(--radius);
    background: var(--surface-2);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--border) 70%, transparent);
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .recipe-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
  }

  .recipe-card:focus-visible {
    outline: 2px solid var(--sky);
    outline-offset: 3px;
  }

  .recipe-media {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }

  .recipe-cover {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* 无封面时用一块渐变占位,避免卡片塌成 0 高 */
  .recipe-fallback {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 45%),
      linear-gradient(135deg, var(--surface-2), var(--surface));
  }

  .recipe-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(8, 10, 14, 0.84) 0%,
      rgba(8, 10, 14, 0.36) 42%,
      transparent 100%
    );
    pointer-events: none;
  }

  .recipe-body {
    position: absolute;
    z-index: 2;
    inset: auto 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .recipe-date {
    font-size: 0.72rem;
    opacity: 0.85;
  }

  .recipe-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .recipe-chips .chip {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .recipe-title {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .recipe-desc {
    font-size: 0.8rem;
    opacity: 0.88;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipes-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-faint);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  @media (min-width: 560px) {
    .recipes-masonry {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .recipes-masonry {
      columns: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-card {
      transition: none;
    }
    .recipe-card:hover {
      transform: none;
    }
  }
</style>
