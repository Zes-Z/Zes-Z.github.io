---
import { withBase } from '../utils/paths';

/*
网易云音乐外链小挂件。
默认收起为圆形音符按钮,点击展开/收起播放器。
宽幅: https://music.163.com/outchain/player?type=0&id=18360816925&auto=1&height=430
*/

const iframeSrc = 'https://music.163.com/outchain/player?type=0&id=18360816925&auto=1&height=90';
const iconSrc = withBase('/icon/neteasecloudmusic.svg');
---

<div class="music-widget" data-music-widget>
  <div class="music-widget__box" data-music-box hidden>
    <iframe
      title="一起听"
      width="330"
      height="110"
      data-src={iframeSrc}
      loading="lazy"
      style="border: 0"
    ></iframe>
  </div>
  <button class="music-widget__toggle" type="button" data-music-toggle aria-label="一起听" title="一起听">
    <span class="music-widget__icon">
      <img src={iconSrc} alt="" width="24" height="24" />
    </span>
  </button>
</div>

<script>
  const widget = document.querySelector<HTMLElement>('[data-music-widget]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-music-toggle]');
  const box = document.querySelector<HTMLElement>('[data-music-box]');

  if (widget && toggle && box) {
    const iframe = box.querySelector<HTMLIFrameElement>('iframe[data-src]');
    let started = false;

    const sync = (open: boolean) => {
      box.hidden = !open;
      widget.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      // 首次点击:才注入网易云 iframe,浏览器允许用户手势后自动播放
      if (!started && iframe && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        started = true;
        widget.classList.add('is-playing');
      }
      sync(Boolean(box.hidden));
    });
  }
</script>

<style>
  .music-widget {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 70;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .music-widget__box {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-strong);
    background: var(--surface);
  }
  .music-widget__box[hidden] {
    display: none;
  }
  .music-widget__box iframe {
    display: block;
    border-radius: 14px;
    background: transparent;
  }

  .music-widget__toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    color: var(--text-soft);
    cursor: pointer;
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform 0.2s ease;
  }
  .music-widget__toggle:hover {
    border-color: #0fc8e09c;
    transform: scale(1.1);
  }

  .music-widget__icon {
    display: grid;
    place-items: center;
  }
  .music-widget__icon img {
    display: block;
    width: 30px;
    height: 30px;
    border-radius: 50%;
  }
  .music-widget.is-playing .music-widget__icon {
    animation: music-widget-spin 12s linear infinite;
  }

  @keyframes music-widget-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>