---
import { withBase } from '../utils/paths';

/**
 * 单个轮播项:
 * - 字符串:图片或视频路径(按扩展名自动识别)。
 * - 对象:Live Photo 用 src(静帧)+ live(实况视频);duration 可自定义停留毫秒数。
 */
type HeroMedia =
  | string
  | { src: string; live?: string; duration?: number };

interface Props {
  /** 图片、视频,或 iPhone Live Photo 的静帧 + 实况视频。 */
  images: HeroMedia[];
  /** 'full' = ~92vh home hero, 'medium' = shorter page hero (friends page). */
  height?: 'full' | 'medium';
  /** Optional overlay content (site title / subtitle). */
  title?: string;
  subtitle?: string;

  titleHref?: string;
  /**
   * 左下角欢迎文字块 —— 一组 { text, href }。
   * 组件用打字机效果逐条轮播:逐字打出 → 停留 → 逐字删除 → 下一条。
   * 只有一条时只打一遍。整块是一个链接,显示哪条就跳该条的 href。
   */
  welcome?: { text: string; href: string }[];
  /** 右下角附加文字链接(如个人展示站 "About Zes")。 */
  rightTitle?: string;
  /** 右下角附加文字链接的目标。 */
  rightTitleHref?: string;
  /** Overlay placement. */
  position?: 'center' | 'bottom-left';
  /** 普通静态图片的切换间隔(ms);视频/Live Photo 按自身时长播放,不受此值截断。 */
  interval?: number;
}

const {
  images,
  height = 'full',
  title,
  subtitle,
  titleHref,
  welcome,
  rightTitle,
  rightTitleHref,
  position = 'center',
  interval = 6000,
} = Astro.props;
// site.config.ts 里常把暂时不想用的壁纸注释掉,留下空字符串条目。
// 直接渲染会产出 <img src=""> 这种必然 404 的请求,所以这里先过滤掉。
const heroImages = images
  .map((item) =>
    typeof item === 'string'
      ? {
          src: item.trim(),
          live: undefined as string | undefined,
          duration: undefined as number | undefined,
        }
      : {
          src: (item.src ?? '').trim(),
          live: item.live?.trim() || undefined,
          duration:
            typeof item.duration === 'number' &&
            Number.isFinite(item.duration) &&
            item.duration >= 0
              ? item.duration
              : undefined,
        }
  )
  .filter((item) => Boolean(item.src || item.live));
// 背景视频/Live Photo 的动态部分:静音、内联播放,满足自动播放策略。
const VIDEO_PATTERN = /\.(mp4|webm|ogv|ogg|mov|m4v)(?:[?#].*)?$/i;
const isVideo = (src: string) => VIDEO_PATTERN.test(src);
// 丢掉空文本;每条保留自己的 href
const welcomeItems = (welcome ?? [])
  .filter((item) => Boolean(item.text?.trim()))
  .map((item) => ({ text: item.text, href: withBase(item.href) }));
const hasWelcome = welcomeItems.length > 0;
const hasOverlay = Boolean((title || subtitle) && !hasWelcome);
const hasRightTitle = Boolean(rightTitle);
---

<section class:list={['hero', `hero--${height}`]} data-hero data-hero-interval={interval}>
  {
    heroImages.map((item, index) => {
      const still = item.src ? withBase(item.src) : undefined;
      // Live Photo:src 是静帧,live 是 iPhone 导出的 .mov(实况视频)。
      const motion = item.live
        ? withBase(item.live)
        : isVideo(item.src)
          ? withBase(item.src)
          : undefined;
      const poster = item.live && !isVideo(item.src) ? still : undefined;
      // 设置 duration 时用 loop 撑满自定义停留时间;否则播完就切下一张。
      const loop = item.duration !== undefined;

      return motion ? (
        <video
          class:list={['hero-image', 'hero-video', { 'is-active': index === 0 }]}
          src={motion}
          poster={poster}
          data-slide-duration={item.duration}
          muted
          loop={loop}
          playsinline
          preload={index === 0 ? 'auto' : 'metadata'}
          aria-hidden="true"
          tabindex="-1"
        />
      ) : (
        <img
          class:list={['hero-image', { 'is-active': index === 0 }]}
          src={still}
          data-slide-duration={item.duration}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          decoding="async"
        />
      );
    })
  }
  <div class="hero-veil"></div>
  <div class="hero-fade-top" aria-hidden="true"></div>
  <div class="hero-fade-bottom" aria-hidden="true"></div>

  {
    hasWelcome && (
      <div class="hero-overlay hero-overlay--bottom-left" data-welcome-root>
        <a
          class="hero-title hero-title-link hero-welcome"
          href={welcomeItems[0]!.href}
          data-welcome
          data-welcome-hrefs={JSON.stringify(welcomeItems.map((i) => i.href))}
          aria-label={welcomeItems.map((i) => i.text).join(' / ')}
        >
          {/* 打字机:逐字打出/删除。首句静态渲染,保证无 JS 时也能看到并点击。 */}
          <span class="hero-welcome-text" data-welcome-text>{welcomeItems[0]!.text}</span>
          <span class="hero-welcome-caret" aria-hidden="true" />
        </a>
        {/* 句子列表必须是 <a> 的兄弟节点:
            HTML 解析器遇到 <a> 内的 <template> 会提前闭合 <a>,导致结构错乱。
            也刻意不用 data- 属性承载句子,避免换行被规范化成空格。 */}
        <template data-welcome-sentences>
          {
            welcomeItems.map((item) => (
              <span data-text={item.text} />
            ))
          }
        </template>
      </div>
    )
  }

  {hasOverlay && (
    <div class:list={['hero-overlay', `hero-overlay--${position}`]}>
      {title &&
        (titleHref ? (
          <a class="hero-title hero-title-link" href={withBase(titleHref)}>{title}</a>
        ) : (
          <h1 class="hero-title">{title}</h1>
        ))}
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    </div>
  )}

  {hasRightTitle &&
    (rightTitleHref ? (
      <a class="hero-title-link hero-corner-right" href={withBase(rightTitleHref)}>{rightTitle}</a>
    ) : (
      <span class="hero-title-link hero-corner-right">{rightTitle}</span>
    ))}

  {height === 'full' && (
    <button class="scroll-down" type="button" data-scroll-down aria-label="scroll down">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5" />
      </svg>
    </button>
  )}
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !hero.dataset.ready) {
    hero.dataset.ready = 'true';
    const media = [...hero.querySelectorAll<HTMLElement>('.hero-image')];
    const videos = media.filter((el): el is HTMLVideoElement => el instanceof HTMLVideoElement);
    const rawInterval = Number(hero.dataset.heroInterval ?? 6000);
    const interval = Number.isFinite(rawInterval) && rawInterval > 0 ? rawInterval : 6000;
    // 视频在结束前 0.3 秒切走,避免最后一帧/黑屏参与淡出时闪一下。
    const videoEndOffset = 300;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = Math.max(
      0,
      media.findIndex((el) => el.classList.contains('is-active'))
    );
    let timer: number | undefined;

    const clearTimer = () => {
      if (timer === undefined) return;
      window.clearTimeout(timer);
      timer = undefined;
    };

    /** data-slide-duration:自定义停留毫秒数;0 = 一直停留,undefined = 按素材类型。 */
    const explicitDuration = (el: HTMLElement): number | undefined => {
      const raw = el.dataset.slideDuration;
      if (raw === undefined || raw === '') return undefined;
      const value = Number(raw);
      return Number.isFinite(value) && value >= 0 ? value : undefined;
    };

    /** 从第一帧开始播放;自动播放被拒绝时静默忽略(静音视频通常允许)。 */
    const playVideo = (el: Element | undefined) => {
      if (!(el instanceof HTMLVideoElement)) return;
      try {
        // 只在新进入这张时回到开头。离开时不要重置,否则淡出的仍是第一帧,
        // 会和刚播放到的画面产生跳变/闪屏。
        el.currentTime = 0;
      } catch {
        /* metadata 尚未加载时忽略 */
      }
      void el.play().catch(() => {});
    };

    const pauseVideo = (el: Element) => {
      if (!(el instanceof HTMLVideoElement)) return;
      // 暂停时保留当前帧,让 2.4s 的淡出继续显示最后一帧。
      el.pause();
    };

    const resetVideo = (el: Element) => {
      if (!(el instanceof HTMLVideoElement)) return;
      el.pause();
      try {
        el.currentTime = 0;
      } catch {
        /* metadata 尚未加载时忽略 */
      }
    };

    const schedule = (delay: number) => {
      clearTimer();
      // 只有一张时无需轮播;视频仍然会正常播放。
      if (media.length <= 1) return;
      if (!Number.isFinite(delay) || delay < 0) return;
      timer = window.setTimeout(advance, Math.max(250, delay));
    };

    const scheduleFor = (el: HTMLElement) => {
      const explicit = explicitDuration(el);
      if (explicit !== undefined) {
        // 0 表示这张不自动切走。
        if (explicit === 0) {
          clearTimer();
          return;
        }
        // 视频同样提前 0.3 秒切走;普通图片的自定义时长保持原样。
        const offset = el instanceof HTMLVideoElement ? videoEndOffset : 0;
        schedule(Math.max(0, explicit - offset));
        return;
      }

      if (el instanceof HTMLVideoElement) {
        // 视频按自身时长播放,提前 0.3 秒切走,不受普通图片间隔影响。
        const duration = el.duration;
        if (Number.isFinite(duration) && duration > 0) {
          schedule(Math.max(0, duration * 1000 - videoEndOffset));
          return;
        }
        // 元数据还没到:等 loadedmetadata 后再决定;长时间没有就按普通间隔兜底。
        const onMetadata = () => {
          if (el !== media[current]) return;
          const known = el.duration;
          schedule(
            Number.isFinite(known) && known > 0
              ? Math.max(0, known * 1000 - videoEndOffset)
              : interval
          );
        };
        el.addEventListener('loadedmetadata', onMetadata, { once: true });
        window.setTimeout(() => {
          if (el !== media[current] || explicitDuration(el) !== undefined) return;
          const known = el.duration;
          if (!Number.isFinite(known) || known <= 0) schedule(interval);
        }, interval);
        return;
      }

      // 普通图片照旧:按全局间隔轮播。
      schedule(interval);
    };

    const startCurrent = () => {
      const el = media[current];
      if (!el) return;
      if (el instanceof HTMLVideoElement) playVideo(el);
      scheduleFor(el);
    };

    const advance = () => {
      clearTimer();
      if (media.length === 0) return;

      const leaving = media[current];
      if (leaving) {
        leaving.classList.remove('is-active');
        pauseVideo(leaving);
      }

      current = (current + 1) % media.length;
      media.forEach((el, index) => el.classList.toggle('is-active', index === current));

      const next = media[current];
      if (!next) return;
      if (next instanceof HTMLVideoElement) playVideo(next);
      scheduleFor(next);
    };

    // 没有自定义时长时,视频播完立即切下一张(比 duration 兜底计时器更准)。
    videos.forEach((video) => {
      video.addEventListener('ended', () => {
        if (video !== media[current]) return;
        if (explicitDuration(video) !== undefined) return;
        advance();
      });
    });

    if (reducedMotion) {
      // 减少动态效果时保留首帧,不自动播放背景视频。
      videos.forEach(resetVideo);
    } else {
      // 只为当前媒体解码,避免多个视频/Live Photo 同时播放。
      videos.forEach((video) => {
        if (video !== media[current]) pauseVideo(video);
      });
      startCurrent();
    }
  }

  // 向下箭头:点击滚动到下一板块(滚动越过主图高度即可露出下方内容)
  const arrow = document.querySelector<HTMLButtonElement>('[data-scroll-down]');
  if (arrow) {
    arrow.addEventListener('click', () => {
      const heroEl = arrow.closest<HTMLElement>('.hero');
      const top = heroEl ? heroEl.getBoundingClientRect().top + window.scrollY + heroEl.offsetHeight : 0;
      window.scrollTo({ top: top + 1, behavior: 'smooth' });
    });
  }

  /* ---------------------------------------------------------
   * 左下角欢迎文字:打字机效果
   *   逐字打出 -> 停留 -> 逐字删除 -> 下一条(只有一条时只打一遍)
   *
   * 时序参考 https://i.hin.cool 的实现:
   *   打字 80ms/字 · 停留 2000ms · 删除 40ms/字 · 句间 500ms · 起始延迟 800ms
   *
   * 这里刻意不因 prefers-reduced-motion 短路:打字机是内容呈现方式,
   * 一旦短路,开启"减少动态效果"的用户会完全看不到文字。
   * 整块始终是链接:切到哪一条,就把该条自己的 href 写到 <a> 上。
   * --------------------------------------------------------- */
  const welcomeEl = document.querySelector<HTMLAnchorElement>('[data-welcome]');
  if (welcomeEl && !welcomeEl.dataset.ready) {
    welcomeEl.dataset.ready = 'true';

    const textEl = welcomeEl.querySelector<HTMLElement>('[data-welcome-text]');

    /**
     * 读取句子列表。
     *
     * 注意:这些句子放在 <template> 里(它必须是 <a> 的兄弟节点,否则 HTML
     * 解析器会提前闭合 <a>)。而 <template> 的内容位于独立的 DocumentFragment
     * —— 不属于文档树,普通 querySelectorAll 永远查不到,必须访问 .content。
     */
    const sentenceTemplate =
      welcomeEl.parentElement?.querySelector<HTMLTemplateElement>('[data-welcome-sentences]') ??
      null;
    const sentences = sentenceTemplate
      ? [...sentenceTemplate.content.querySelectorAll<HTMLElement>('[data-text]')].map(
          (el) => el.dataset.text ?? ''
        )
      : [];
    const hrefs: string[] = JSON.parse(welcomeEl.dataset.welcomeHrefs ?? '[]');

    if (textEl && sentences.length > 0) {
      const TYPE_MS = 100;
      const DELETE_MS = 48;
      const HOLD_MS = 3000;
      const BETWEEN_MS = 600;
      const START_MS = 600;

      let phraseIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      let timer = 0;

      const applyHref = (i: number) => {
        welcomeEl.setAttribute('href', hrefs[i % hrefs.length] ?? welcomeEl.href);
      };

      const loop = () => {
        const phrase = sentences[phraseIndex]!;

        if (!isDeleting) {
          charIndex += 1;
          textEl.textContent = phrase.slice(0, charIndex);

          if (charIndex === phrase.length) {
            isDeleting = true;
            timer = window.setTimeout(loop, HOLD_MS);
            return;
          }
          timer = window.setTimeout(loop, TYPE_MS);
          return;
        }

        charIndex -= 1;
        textEl.textContent = phrase.slice(0, charIndex);

        if (charIndex === 0) {
          isDeleting = false;
          // 只有一条 -> 停在这里,不再循环
          if (sentences.length === 1) return;
          phraseIndex = (phraseIndex + 1) % sentences.length;
          applyHref(phraseIndex);
          
          timer = window.setTimeout(loop, BETWEEN_MS);
          return;
        }
        timer = window.setTimeout(loop, DELETE_MS);
      };

      // 首句已在 HTML 里(无 JS 回退),这里清空后重新打
      textEl.textContent = '';
      applyHref(0);
      timer = window.setTimeout(loop, START_MS);

      // 切到后台时停表,回来继续,避免后台空转
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) window.clearTimeout(timer);
        else timer = window.setTimeout(loop, TYPE_MS);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .hero--full {
    height: 100vh;
    height: 100dvh;
    min-height: 480px;
  }
  .hero--medium {
    height: min(72vh, 600px);
    min-height: 360px;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* 柔和淡入淡出 */
    transition: opacity 2.4s ease-in-out;
  }
  .hero-image.is-active {
    opacity: 1;
  }
  /* 背景视频只是装饰,不拦截点击/滚动;自动静音、循环、内联播放 */
  .hero-video {
    pointer-events: none;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-veil);
    pointer-events: none;
  }

  /* 顶部渐隐:与透明导航栏融合(quietpages 式) */
  .hero-fade-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 9rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.4), transparent);
    pointer-events: none;
  }
  /* 底部渐隐:柔和融入页面背景(弱化版) */
  .hero-fade-bottom {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    height: clamp(3.5rem, 8vh, 6.5rem);
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bg) 45%, transparent));
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 2rem;
    text-align: center;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  /* 左下角小文字块(quietpages 式) */
  .hero-overlay--bottom-left {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    padding: 0 5vw 2.7rem 4.2vw;
  }
  .hero-overlay--bottom-left .hero-title,
  .hero-overlay--bottom-left .hero-title-link,
  .hero-corner-right {
    /* 斜体艺术字:圆润无衬线(Nunito),保持倾斜与可读性 */
    font-size: clamp(1.2rem, 2.1vw, 1.7rem);
    font-weight: 600;
    font-style: italic;
    font-family: 'Nunito', 'Segoe UI', 'PingFang SC', 'Hiragino Sans', 'Noto Sans JP',
      'Noto Sans SC', system-ui, sans-serif;
    letter-spacing: 0.015em;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }
  .hero-overlay--bottom-left .hero-subtitle {
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    max-width: 34em;
    opacity: 0.88;
  }

  /* ---------- 左下角欢迎块(打字机) ---------- */

  /* 字体完全继承上面的 `.hero-overlay--bottom-left .hero-title-link`
     (Nunito 斜体 + 同样的字号),与右下角 "About Zes" 统一 —— 这里不覆盖字体。 */

  .hero-welcome {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    line-height: 1.3;
    max-width: 82vw;
  }

  .hero-welcome-text {
    display: inline-block;
    text-align: left;
    white-space: pre;
    /* 打完一句时脚本会锁定宽度,删除阶段整块不抖动 */
    min-width: 0;
  }

  /* 打字光标:跟随 currentColor(大图上是白色) */
  .hero-welcome-caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 3px;
    background: currentColor;
    opacity: 0.85;
    animation: hero-caret-blink 1.05s step-end infinite;
  }

  @keyframes hero-caret-blink {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* 只关掉光标闪烁;打字机本身保留(它是内容,不是装饰动画) */
    .hero-welcome-caret {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .hero-welcome-text {
      white-space: normal;
    }
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  /* 左下角"关于我"文章链接 */
  .hero-title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 1px;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero-title-link:hover {
    border-color: #fff;
    color: #fff;
  }

  /* 右下角"About Zes"个人展示站文字链接 */
  .hero-corner-right {
    position: absolute;
    right: 4.2vw;
    bottom: 2.7rem;
    z-index: 4;
    max-width: min(40vw, 26em);
    color: #fff;
    text-align: right;
  }


  
  .hero-subtitle {
    margin: 0;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    font-weight: 400;
    opacity: 0.92;
    max-width: 42em;
  }

  /* 向下箭头:底部居中,上下弹跳(无圆圈包裹,仅图标) */
  .scroll-down {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    animation: scroll-bounce 2.2s ease-in-out infinite;
    transition: color var(--transition-fast);
  }
  .scroll-down:hover {
    color: #fff;
