---
import { withBase } from '../utils/paths';

interface Props {
  images: string[];
  /** 'full' = ~92vh home hero, 'medium' = shorter page hero (friends page). */
  height?: 'full' | 'medium';
  /** Optional overlay content (site title / subtitle). */
  title?: string;
  subtitle?: string;

  titleHref?: string;
  /** 右下角附加文字链接(如个人展示站 "About Zes")。 */
  rightTitle?: string;
  /** 右下角附加文字链接的目标。 */
  rightTitleHref?: string;
  /** Overlay placement. */
  position?: 'center' | 'bottom-left';
  /** Crossfade interval in ms. */
  interval?: number;
}

const {
  images,
  height = 'full',
  title,
  subtitle,
  titleHref,
  rightTitle,
  rightTitleHref,
  position = 'center',
  interval = 6000,
} = Astro.props;
const hasOverlay = Boolean(title || subtitle);
const hasRightTitle = Boolean(rightTitle);
---

<section class:list={['hero', `hero--${height}`]} data-hero data-hero-interval={interval}>
  {
    images.map((src, index) => (
      <img
        class:list={['hero-image', { 'is-active': index === 0 }]}
        src={withBase(src)}
        alt=""
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))
  }
  <div class="hero-veil"></div>
  <div class="hero-fade-top" aria-hidden="true"></div>
  <div class="hero-fade-bottom" aria-hidden="true"></div>
  {hasOverlay && (
    <div class:list={['hero-overlay', `hero-overlay--${position}`]}>
      {title &&
        (titleHref ? (
          <a class="hero-title hero-title-link" href={withBase(titleHref)}>{title}</a>
        ) : (
          <h1 class="hero-title">{title}</h1>
        ))}
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    </div>
  )}

  {hasRightTitle &&
    (rightTitleHref ? (
      <a class="hero-title-link hero-corner-right" href={withBase(rightTitleHref)}>{rightTitle}</a>
    ) : (
      <span class="hero-title-link hero-corner-right">{rightTitle}</span>
    ))}

  {height === 'full' && (
    <button class="scroll-down" type="button" data-scroll-down aria-label="scroll down">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5" />
      </svg>
    </button>
  )}
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !hero.dataset.ready) {
    hero.dataset.ready = 'true';
    const images = [...hero.querySelectorAll<HTMLImageElement>('.hero-image')];
    const interval = Number(hero.dataset.heroInterval ?? 6000);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (images.length > 1 && !reducedMotion) {
      let index = 0;
      window.setInterval(() => {
        const current = images[index]!;
        const next = images[(index + 1) % images.length]!;
        current.classList.remove('is-active');
        next.classList.add('is-active');
        index = (index + 1) % images.length;
      }, interval);
    }
  }

  // 向下箭头:点击滚动到下一板块(滚动越过主图高度即可露出下方内容)
  const arrow = document.querySelector<HTMLButtonElement>('[data-scroll-down]');
  if (arrow) {
    arrow.addEventListener('click', () => {
      const heroEl = arrow.closest<HTMLElement>('.hero');
      const top = heroEl ? heroEl.getBoundingClientRect().top + window.scrollY + heroEl.offsetHeight : 0;
      window.scrollTo({ top: top + 1, behavior: 'smooth' });
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .hero--full {
    height: 100vh;
    height: 100dvh;
    min-height: 480px;
  }
  .hero--medium {
    height: min(68vh, 520px);
    min-height: 320px;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* 柔和淡入淡出 */
    transition: opacity 2.4s ease-in-out;
  }
  .hero-image.is-active {
    opacity: 1;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-veil);
    pointer-events: none;
  }

  /* 顶部渐隐:与透明导航栏融合(quietpages 式) */
  .hero-fade-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 9rem;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.4), transparent);
    pointer-events: none;
  }
  /* 底部渐隐:柔和融入页面背景(弱化版) */
  .hero-fade-bottom {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    height: clamp(3.5rem, 8vh, 6.5rem);
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bg) 45%, transparent));
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 2rem;
    text-align: center;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  /* 左下角小文字块(quietpages 式) */
  .hero-overlay--bottom-left {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    padding: 0 5vw 2.7rem 4.2vw;
  }
  .hero-overlay--bottom-left .hero-title,
  .hero-overlay--bottom-left .hero-title-link,
  .hero-corner-right {
    /* 斜体艺术字:圆润无衬线(Nunito),保持倾斜与可读性 */
    font-size: clamp(1.2rem, 2.1vw, 1.7rem);
    font-weight: 600;
    font-style: italic;
    font-family: 'Nunito', 'Segoe UI', 'PingFang SC', 'Hiragino Sans', 'Noto Sans JP',
      'Noto Sans SC', system-ui, sans-serif;
    letter-spacing: 0.015em;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }
  .hero-overlay--bottom-left .hero-subtitle {
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    max-width: 34em;
    opacity: 0.88;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  /* 左下角"关于我"文章链接 */
  .hero-title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 1px;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero-title-link:hover {
    border-color: #fff;
    color: #fff;
  }

  /* 右下角"About Zes"个人展示站文字链接 */
  .hero-corner-right {
    position: absolute;
    right: 4.2vw;
    bottom: 2.7rem;
    z-index: 4;
    max-width: min(40vw, 26em);
    color: #fff;
    text-align: right;
  }


  
  .hero-subtitle {
    margin: 0;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    font-weight: 400;
    opacity: 0.92;
    max-width: 42em;
  }

  /* 向下箭头:底部居中,上下弹跳(无圆圈包裹,仅图标) */
  .scroll-down {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    animation: scroll-bounce 2.2s ease-in-out infinite;
    transition: color var(--transition-fast);
  }
  .scroll-down:hover {
    color: #fff;
  }

  @keyframes scroll-bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-down {
      animation: none;
    }
  }
</style>
