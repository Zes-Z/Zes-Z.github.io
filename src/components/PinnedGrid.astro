---
interface PinnedCard {
  href: string;
  title: string;
  category: string;
  date: string;
  datetime?: string;
  image?: string;
  original?: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  cards: PinnedCard[];
}

const { cards } = Astro.props;
---

<div class:list={['pin-grid', `pin-grid--count-${Math.min(cards.length, 3)}`]} data-pinned-chroma>
  {cards.map((card, index) => (
    <a class:list={['pin-card', { 'pin-card--lead': index === 0 }]} href={card.href} data-chroma-card>
      <span class="pin-media" data-chroma-area>
        {card.image ? (
          <>
            <img
              class="pin-image pin-image--mono"
              src={card.image}
              srcset={card.srcset}
              sizes={card.sizes}
              data-progressive-original={card.original}
              data-progressive-role={card.original ? 'pinned' : undefined}
              data-fallback={card.original}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <img
              class="pin-image pin-image--color"
              src={card.image}
              srcset={card.srcset}
              sizes={card.sizes}
              data-fallback={card.original}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          </>
        ) : (
          <>
            <span class="pin-fallback pin-fallback--mono" aria-hidden="true"></span>
            <span class="pin-fallback pin-fallback--color" aria-hidden="true"></span>
          </>
        )}
        <span class="pin-media-rim" aria-hidden="true"></span>
      </span>

      <span class="pin-info">
        <strong class="pin-title">{card.title}</strong>
        <span class="pin-meta">
          {card.date && <time datetime={card.datetime}>{card.date}</time>}
          {card.category && <span class="pin-category">{card.category}</span>}
        </span>
      </span>
      <span class="pin-glow" aria-hidden="true"></span>
    </a>
  ))}
</div>

<script>
  // Astro adaptation of React Bits Chroma Grid's shared cursor spotlight.
  // https://reactbits.dev/components/chroma-grid
  let cleanupPinnedChroma: Array<() => void> = [];

  function bindPinnedChroma() {
    cleanupPinnedChroma.forEach((cleanup) => cleanup());
    cleanupPinnedChroma = [];

    document.querySelectorAll<HTMLElement>('[data-pinned-chroma]').forEach((grid) => {
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const areas = grid.querySelectorAll<HTMLElement>('[data-chroma-area], [data-chroma-card]');
      const state = { x: 0, y: 0, tx: 0, ty: 0, power: 0, target: 0, primed: false };
      let raf = 0;
      let last = 0;

      const place = () => {
        const root = grid.getBoundingClientRect();
        areas.forEach((area) => {
          const rect = area.getBoundingClientRect();
          area.style.setProperty('--chroma-offset-x', `${rect.left - root.left}px`);
          area.style.setProperty('--chroma-offset-y', `${rect.top - root.top}px`);
        });
      };

      const frame = (now: number) => {
        raf = 0;
        const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60;
        last = now;
        const follow = 1 - Math.exp(-dt / 0.14);
        const fade = 1 - Math.exp(-dt / (state.target ? 0.1 : 0.2));
        state.x += (state.tx - state.x) * follow;
        state.y += (state.ty - state.y) * follow;
        state.power += (state.target - state.power) * fade;
        grid.style.setProperty('--chroma-x', `${state.x.toFixed(2)}px`);
        grid.style.setProperty('--chroma-y', `${state.y.toFixed(2)}px`);
        grid.style.setProperty('--chroma-power', state.power.toFixed(4));
        if (Math.abs(state.tx - state.x) > 0.1 || Math.abs(state.ty - state.y) > 0.1 ||
            Math.abs(state.target - state.power) > 0.002) {
          raf = requestAnimationFrame(frame);
        } else {
          last = 0;
        }
      };

      const wake = () => { if (!raf) raf = requestAnimationFrame(frame); };
      const onMove = (event: PointerEvent) => {
        if (event.pointerType === 'touch') return;
        const rect = grid.getBoundingClientRect();
        state.tx = event.clientX - rect.left;
        state.ty = event.clientY - rect.top;
        if (!state.primed || state.power < 0.02) {
          state.x = state.tx;
          state.y = state.ty;
          state.primed = true;
        }
        state.target = 1;
        wake();
      };
      const onLeave = () => { state.target = 0; wake(); };

      const resizeObserver = new ResizeObserver(place);
      resizeObserver.observe(grid);
      grid.addEventListener('pointermove', onMove);
      grid.addEventListener('pointerdown', onMove);
      grid.addEventListener('pointerleave', onLeave);
      grid.addEventListener('pointercancel', onLeave);
      place();
      cleanupPinnedChroma.push(() => {
        cancelAnimationFrame(raf);
        resizeObserver.disconnect();
        grid.removeEventListener('pointermove', onMove);
        grid.removeEventListener('pointerdown', onMove);
        grid.removeEventListener('pointerleave', onLeave);
        grid.removeEventListener('pointercancel', onLeave);
      });
    });
  }

  bindPinnedChroma();
  document.addEventListener('astro:page-load', bindPinnedChroma);
  document.addEventListener('astro:before-swap', () => {
    cleanupPinnedChroma.forEach((cleanup) => cleanup());
    cleanupPinnedChroma = [];
  });
</script>

<style>
  .pin-grid {
    --chroma-x: -9999px;
    --chroma-y: -9999px;
    --chroma-power: 0;
    display: grid;
    grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.15rem);
    height: clamp(480px, 40vw, 510px);
  }

  .pin-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    min-height: 0;
    padding: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--text);
    isolation: isolate;
    transition: border-color 240ms ease, box-shadow 240ms ease;
  }

  .pin-card:hover,
  .pin-card:focus-visible {
    border-color: color-mix(in srgb, var(--sky) 55%, var(--border));
    box-shadow: var(--shadow-strong);
    color: var(--text);
  }

  .pin-card:focus-visible {
    outline: 2px solid var(--sky);
    outline-offset: 3px;
  }

  .pin-card--lead { grid-column: 1; grid-row: 1 / span 2; }
  .pin-media {
    position: relative;
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 8px);
    background: var(--surface-2);
  }

  .pin-image, .pin-fallback {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .pin-image { object-fit: cover; }
  .pin-image--mono, .pin-fallback--mono {
    filter: grayscale(1) brightness(0.88);
    transition: filter 480ms ease;
  }
  .pin-card--lead:hover .pin-image--mono,
  .pin-card--lead:hover .pin-fallback--mono {
    filter: grayscale(0) brightness(1);
  }
  .pin-image--color, .pin-fallback--color {
    opacity: var(--chroma-power);
    -webkit-mask-image: radial-gradient(circle 260px at calc(var(--chroma-x) - var(--chroma-offset-x, 0px)) calc(var(--chroma-y) - var(--chroma-offset-y, 0px)), #000 0%, #000 26%, transparent 100%);
    mask-image: radial-gradient(circle 260px at calc(var(--chroma-x) - var(--chroma-offset-x, 0px)) calc(var(--chroma-y) - var(--chroma-offset-y, 0px)), #000 0%, #000 26%, transparent 100%);
  }

  .pin-fallback {
    background:
      radial-gradient(circle at 78% 20%, color-mix(in srgb, var(--sky) 30%, transparent), transparent 44%),
      linear-gradient(135deg, var(--surface-2), color-mix(in srgb, var(--sky) 12%, var(--surface)));
  }

  .pin-media-rim {
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent);
    pointer-events: none;
  }

  .pin-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.15rem 0.6rem 0.35rem;
  }

  .pin-meta {
    display: flex;
    align-items: baseline;
    gap: clamp(0.8rem, 1.5vw, 1.35rem);
    color: var(--text-faint);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .pin-category { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pin-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text);
    font-size: clamp(1.02rem, 1.55vw, 1.28rem);
    font-weight: 750;
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .pin-card--lead .pin-title { font-size: clamp(1.5rem, 2.5vw, 2.1rem); }
  .pin-info time { flex: none; font-family: var(--font-mono); }

  .pin-glow {
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--sky), inset 0 0 18px -8px var(--sky);
    opacity: var(--chroma-power);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle 260px at calc(var(--chroma-x) - var(--chroma-offset-x, 0px)) calc(var(--chroma-y) - var(--chroma-offset-y, 0px)), #000 0%, transparent 100%);
    mask-image: radial-gradient(circle 260px at calc(var(--chroma-x) - var(--chroma-offset-x, 0px)) calc(var(--chroma-y) - var(--chroma-offset-y, 0px)), #000 0%, transparent 100%);
  }

  .pin-grid--count-1 { grid-template-columns: minmax(0, 1fr); height: 440px; }
  .pin-grid--count-2 { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); height: 450px; }
  .pin-grid--count-2 .pin-card:not(.pin-card--lead) { grid-column: 2; grid-row: 1 / span 2; }

  @media (max-width: 700px) {
    .pin-grid, .pin-grid--count-1 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      height: auto;
    }
    .pin-card--lead { grid-column: 1 / -1; grid-row: auto; height: 390px; }
    .pin-card:not(.pin-card--lead) { height: 260px; }
    .pin-grid--count-2 .pin-card:not(.pin-card--lead) { grid-column: 1 / -1; grid-row: auto; }
  }

  @media (max-width: 520px) {
    .pin-grid, .pin-grid--count-1 { grid-template-columns: minmax(0, 1fr); }
    .pin-card--lead { height: 340px; }
    .pin-card:not(.pin-card--lead) { height: 255px; }
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .pin-image--mono, .pin-fallback--mono { filter: none; }
    .pin-image--color, .pin-fallback--color, .pin-glow { display: none; }
  }

  .pin-card:focus-visible .pin-image--mono,
  .pin-card:focus-visible .pin-fallback--mono { filter: none; }
  .pin-card:focus-visible .pin-image--color,
  .pin-card:focus-visible .pin-fallback--color { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .pin-image--mono, .pin-fallback--mono { transition: none; }
  }
</style>
