---
interface Props {
  cards: {
    href: string;
    title: string;
    description: string;
    date: string;
    image?: string;
  }[];
}

const { cards } = Astro.props;
---

<div class:list={['pin-grid', `pin-grid--count-${Math.min(cards.length, 5)}`]}>
  {
    cards.map((card, index) => {
      // 布局:左侧 1 张大图(占满两行)+ 右侧 2 个小图块(上下堆叠)
      const variant =
        index === 0
          ? 'pin-card--big'
          : index === 1 || index === 2
            ? 'pin-card--side'
            : 'pin-card--extra';
      return (
        <a class:list={['pin-card', variant]} href={card.href}>
          {card.image ? (
            <img
              class="pin-card-img"
              src={card.image}
              alt={card.title}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <div class="pin-card-fallback" aria-hidden="true"></div>
          )}
          <span class="pin-card-veil"></span>
          <span class="pin-card-body">
            <time class="pin-card-date">{card.date}</time>
            <span class="pin-card-title">{card.title}</span>
            {index === 0 && card.description && <span class="pin-card-desc">{card.description}</span>}
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .pin-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    height: clamp(420px, 56vh, 560px);
  }

  .pin-card {
    position: relative;
    display: flex;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  /* 左侧大图:占满第一列的两行 */
  .pin-card--big {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  /* 右侧两个小图块:第二列第一/二行 */
  .pin-card--side {
    grid-column: 2;
    grid-row: auto;
  }
  /* 超过 3 篇的额外卡片:整行 */
  .pin-card--extra {
    grid-column: 1 / -1;
    height: 200px;
  }

  .pin-card-img,
  .pin-card-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pin-card-fallback {
    background:
      radial-gradient(circle at 26% 22%, var(--accent-soft), transparent 40%),
      linear-gradient(135deg, var(--surface-2), var(--surface));
  }

  .pin-card:hover .pin-card-img {
    transform: scale(1.07);
  }

  .pin-card-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 40%, rgba(10, 12, 16, 0.72));
  }

  .pin-card-body {
    position: absolute;
    z-index: 2;
    inset: auto 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .pin-card-date {
    font-size: 0.72rem;
    opacity: 0.85;
  }

  .pin-card-title {
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    line-height: 1.3;
  }
  .pin-card--big .pin-card-title {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
  }

  .pin-card-desc {
    font-size: 0.85rem;
    opacity: 0.85;
    max-width: 40ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 只有 1 篇时:大图占满整行 */
  .pin-grid--count-1 .pin-card--big {
    grid-column: 1 / -1;
  }

  @media (max-width: 860px) {
    .pin-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }
    .pin-card {
      height: 210px;
    }
    .pin-card--big,
    .pin-card--extra {
      grid-column: 1 / -1;
      height: 300px;
    }
    .pin-card-desc {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .pin-card {
      height: 180px;
    }
    .pin-card--big,
    .pin-card--extra {
      height: 240px;
    }
  }
</style>
