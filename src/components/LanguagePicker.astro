---
import { siteConfig } from '../site.config';
import { t } from '../i18n';
import type { Language } from '../types';
import { localizePath } from '../utils/paths';
import { panelIcon } from '../icons';

interface Props {
  lang: Language;
  pathname: string;
}

const { lang, pathname } = Astro.props;

// 单击轮换:中文 → English → 日本語 → 中文 …
const langs = siteConfig.langs;
const next = langs[(langs.indexOf(lang) + 1) % langs.length]!;
const nextLabel = t(next, 'lang.name');
---

<language-picker>
  <a
    class="icon-btn lang-btn"
    href={localizePath(pathname, next)}
    aria-label={`${t(lang, 'lang.switch')} → ${nextLabel}`}
  >
    <span class="nav-icon" set:html={panelIcon('globe')} />
    <span class="lang-current">{lang.toUpperCase()}</span>
  </a>
</language-picker>

<style>
  language-picker {
    display: inline-flex;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: auto;
    height: 38px;
    padding: 0 12px;
  }

  .lang-current {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
