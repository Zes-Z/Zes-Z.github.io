---
import type { GalleryWallItem } from '../utils/photos';

interface Props {
  items: GalleryWallItem[];
  /**
   * `caption` — always-visible gradient caption (main gallery).
   * `related` — image-first card with a hover/focus overlay (detail page).
   */
  variant?: 'caption' | 'related';
  /** Number of leading images loaded eagerly. */
  eagerCount?: number;
  ariaLabel?: string;
}

const {
  items,
  variant = 'caption',
  eagerCount = 6,
  ariaLabel,
} = Astro.props;

/*
 * CSS columns balance a handful of cards into one tall column. For tiny
 * sets (small albums / related lists) an inline grid keeps them even.
 */
const sparse = items.length <= 3;
const wallStyle = sparse
  ? 'display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:1.25rem;'
  : undefined;
const itemStyle = sparse ? 'margin:0;' : undefined;
---

<div
  class:list={['gallery-wall', `gallery-wall--${variant}`]}
  style={wallStyle}
  role="list"
  aria-label={ariaLabel}
>
  {
    items.map((item, index) => (
      <div class="gallery-item" style={itemStyle} role="listitem">
        <a
          class="gallery-card"
          href={item.href}
          style={
            item.transitionName
              ? `view-transition-name: ${item.transitionName}`
              : undefined
          }
        >
          <img
            class="gallery-img"
            src={item.photo.thumb.src}
            width={item.photo.thumb.width}
            height={item.photo.thumb.height}
            alt={item.title ?? item.photo.title}
            loading={index < eagerCount ? 'eager' : 'lazy'}
            fetchpriority={index < 2 ? 'high' : undefined}
            decoding="async"
          />
          <span class="gallery-caption">
            <span class="gallery-title">{item.title ?? item.photo.title}</span>
            {item.subtitle && <span class="gallery-subtitle">{item.subtitle}</span>}
          </span>
        </a>
      </div>
    ))
  }
</div>

<style>
  /*
   * Natural-ratio CSS columns (the same approach as the reference gallery).
   * Every card keeps its own aspect ratio, so the wall packs tightly without
   * JavaScript layout calculation and reflows automatically when a filter or
   * breakpoint changes the column count.
   */
  .gallery-wall {
    columns: 1;
    column-gap: 1.25rem;
  }

  .gallery-item {
    display: inline-block;
    width: 100%;
    margin: 0 0 1.25rem;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  .gallery-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--border) 70%, transparent);
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-strong);
  }

  .gallery-card:focus-visible {
    outline: 2px solid var(--sky);
    outline-offset: 3px;
  }

  .gallery-img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface-2);
    object-fit: cover;
  }

  /* Always-visible caption, as in the reference gallery. */
  .gallery-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 2.7rem 0.95rem 0.85rem;
    background: linear-gradient(
      to top,
      rgba(8, 10, 14, 0.82) 0%,
      rgba(8, 10, 14, 0.38) 48%,
      transparent 100%
    );
    pointer-events: none;
  }

  .gallery-title {
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  .gallery-subtitle {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Related grid on the detail page: clean image until hover/focus. */
  .gallery-wall--related .gallery-card {
    border-radius: var(--radius-sm);
    box-shadow: none;
  }

  .gallery-wall--related .gallery-img {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-wall--related .gallery-card:hover .gallery-img,
  .gallery-wall--related .gallery-card:focus-visible .gallery-img {
    transform: scale(1.03);
  }

  .gallery-wall--related .gallery-caption {
    inset: 0;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    text-align: center;
    background: transparent;
    opacity: 0;
    transition:
      opacity 280ms ease,
      background 280ms ease;
  }

  .gallery-wall--related .gallery-card:hover .gallery-caption,
  .gallery-wall--related .gallery-card:focus-visible .gallery-caption {
    background: rgba(8, 10, 14, 0.44);
    opacity: 1;
  }

  .gallery-wall--related .gallery-title {
    white-space: normal;
  }

  .gallery-wall--related .gallery-subtitle {
    white-space: normal;
  }

  /* Touch devices cannot hover: keep a readable caption on related cards. */
  @media (hover: none) {
    .gallery-wall--related .gallery-caption {
      inset: auto 0 0;
      align-items: flex-start;
      justify-content: flex-end;
      padding: 2.2rem 0.85rem 0.75rem;
      text-align: left;
      background: linear-gradient(
        to top,
        rgba(8, 10, 14, 0.82) 0%,
        transparent 100%
      );
      opacity: 1;
    }
  }

  @media (min-width: 560px) {
    .gallery-wall {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .gallery-wall {
      columns: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-card,
    .gallery-img,
    .gallery-caption {
      transition: none;
    }
    .gallery-card:hover,
    .gallery-wall--related .gallery-card:hover .gallery-img {
      transform: none;
    }
  }
</style>
