---
import { t } from '../i18n';
import type { Language } from '../types';
import { archiveHref, archiveCategoryHref } from '../utils/paths';

export interface ArchivePostData {
  id: string;
  href: string;
  title: string;
  category: string;
  tags: string[];
  date: string;
  /** preformatted "YYYY/M/D" */
  year: number;
  month: number;
  day: number;
  image?: string;
  ratio: string;
}

interface Props {
  lang: Language;
  posts: ArchivePostData[];
  categories: [string, number][];
}

const { lang, posts, categories } = Astro.props;

// Timeline grouping done at build time: year → posts
const timeline = posts.reduce<Map<number, ArchivePostData[]>>((map, post) => {
  const list = map.get(post.year) ?? [];
  list.push(post);
  map.set(post.year, list);
  return map;
}, new Map());
const years = [...timeline.keys()].sort((a, b) => b - a);
---

<div class="archive-panel" data-archive-panel data-lang={lang}>
  <div class="archive-main">
    <!-- 分类:最上方,横向胶囊单选,居中 -->
    <div class="archive-categories" role="group" aria-label={t(lang, 'archive.categories')}>
      <a class="category-pill" data-category="" href={archiveHref(lang)}>
        <span>{t(lang, 'archive.all')}</span>
        <span class="filter-count">{posts.length}</span>
      </a>
      {
        categories.map(([name, count]) => (
          <a class="category-pill" data-category={name} href={archiveCategoryHref(lang, name)}>
            <span>{name}</span>
            <span class="filter-count">{count}</span>
          </a>
        ))
      }
    </div>

    <div class="timeline" data-timeline>
      {
        years.map((year) => (
          <section class="timeline-year">
            <h2 class="timeline-year-heading">{year}</h2>
            <ul class="timeline-list">
              {
                (timeline.get(year) ?? []).map((post) => (
                  <li class="timeline-item">
                    <time class="timeline-date">{post.month}/{post.day}</time>
                    <a class="timeline-title" href={post.href}>{post.title}</a>
                    <span class="timeline-meta">
                     {post.tags.map((tagName) => (
                       <span class="chip chip--plain">{tagName}</span>
                     ))}
                     <a
                       class="chip chip-link"
                       href={archiveCategoryHref(lang, post.category)}
                     >
                       {post.category}
                     </a>
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </div>

    <div class="masonry" data-masonry hidden></div>
    <p class="masonry-empty" data-masonry-empty hidden>{t(lang, 'archive.noMatch')}</p>
  </div>
</div>

<script>
  import { initMasonry } from '../scripts/masonry';

  interface ArchiveItem {
    id: string;
    href: string;
    title: string;
    category: string;
    tags: string[];
    date: string;
    year: number;
    month: number;
    day: number;
    image?: string;
    ratio: string;
  }

  const panel = document.querySelector<HTMLElement>('[data-archive-panel]');
  if (panel && panel.dataset.ready !== 'true') {
    panel.dataset.ready = 'true';

    const allPosts: ArchiveItem[] = JSON.parse(
      document.getElementById('archive-posts-data')?.textContent ?? '[]'
    );

  const timeline = panel.querySelector<HTMLElement>('[data-timeline]');
  const masonry = panel.querySelector<HTMLElement>('[data-masonry]');
  const masonryEmpty = panel.querySelector<HTMLElement>('[data-masonry-empty]');
  const relayout = masonry ? initMasonry(masonry) : () => {};

  const state = { category: '' };

  const categoryButtons = [...panel.querySelectorAll<HTMLAnchorElement>('[data-category]')];

  function filtered(): ArchiveItem[] {
    return state.category ? allPosts.filter((post) => post.category === state.category) : allPosts;
  }

  function hasSelection(): boolean {
    return Boolean(state.category);
  }

  function syncFilters(): void {
    categoryButtons.forEach((button) => {
      const active = button.dataset.category === state.category;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  }

  function renderMasonry(): void {
    const posts = filtered();
    masonry!.innerHTML = '';
    if (posts.length === 0) {
      masonryEmpty!.hidden = false;
      return;
    }
    masonryEmpty!.hidden = true;
    posts.forEach((post) => {
      const card = document.createElement('a');
      card.className = 'masonry-card';
      card.href = post.href;
      card.dataset.ratio = post.ratio;
      card.innerHTML = `
        <span class="masonry-media" style="aspect-ratio: ${post.ratio}">
          ${
            post.image
              ? `<img class="masonry-img" src="${post.image}" alt="" loading="lazy" decoding="async" />`
              : `<span class="masonry-fallback"></span>`
          }
        </span>
        <span class="masonry-veil"></span>
        <span class="masonry-caption">
          <time>${post.date}</time>
          <span class="masonry-title">${escapeHtml(post.title)}</span>
          <span class="masonry-chips">
            ${
              post.tags.length
                ? post.tags
                    .map((tagName) => `<span class="chip">${escapeHtml(tagName)}</span>`)
                    .join('')
                : `<span class="chip">${escapeHtml(post.category)}</span>`
            }
          </span>
        </span>
      `;
      masonry!.appendChild(card);
    });
    relayout();
  }

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function syncView(): void {
    if (hasSelection()) {
      timeline!.hidden = true;
      masonry!.hidden = false;
      renderMasonry();
    } else {
      masonry!.hidden = true;
      masonryEmpty!.hidden = true;
      timeline!.hidden = false;
    }
  }

  // 通过 URL 的 ?category=... 进入时,直接展示对应分类视图
  state.category = new URLSearchParams(window.location.search).get('category') ?? '';
  if (state.category) {
    const activeCategory = categoryButtons.find((button) => button.dataset.category === state.category);
    const categoryLabel = activeCategory?.textContent?.trim() || state.category;
    document.title = `${categoryLabel} · ${document.title}`;
  }
  syncFilters();
  syncView();
  }
</script>

<script id="archive-posts-data" type="application/json" is:inline set:html={JSON.stringify(posts)} />

<style>
  .archive-panel {
    max-width: 980px;
    margin: 1.5rem auto 0;
  }

  /* ---------- right top: category pills(居中) ---------- */
  .archive-categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.3rem;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 15px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.86rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }
  .category-pill:hover {
    border-color: var(--hover);
    color: var(--hover);
    background: var(--surface-2);
  }
  .category-pill.is-active {
    background: color-mix(in srgb, var(--sky) 14%, transparent);
    border-color: var(--sky);
    color: var(--sky);
    font-weight: 600;
  }
  .category-pill .filter-count {
    /* 数字:小号、透明底,不要看上去像被选中 */
    background: transparent;
    color: var(--text-faint);
    font-size: 0.72rem;
    line-height: 1;
  }
  .category-pill.is-active .filter-count {
    background: transparent;
    color: var(--sky);
  }

  .chip-link {
    text-decoration: none;
  }
  .chip-link:hover {
    background: color-mix(in srgb, var(--sky) 24%, transparent);
    color: var(--hover);
  }

  /* ---------- right: timeline(竖线) / masonry ---------- */
  .timeline {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    padding-left: 26px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--border-strong), var(--border));
  }

  .timeline-year {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .timeline-year-heading {
    position: relative;
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }
  /* 年份节点(实心圆点,落在竖线上) */
  .timeline-year-heading::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--sky);
    border: 2px solid var(--bg);
    box-sizing: border-box;
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }
  /* 文章节点(空心圆环,落在竖线上) */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 2px solid var(--border-strong);
    box-sizing: border-box;
  }
  .timeline-item:hover {
    background: var(--surface-2);
  }
  .timeline-item:hover::before {
    border-color: var(--sky);
  }

  .timeline-date {
    flex: none;
    width: 3.2em;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .timeline-title {
    flex: 1;
    font-weight: 600;
    color: var(--text);
  }
  .timeline-title:hover {
    color: var(--hover);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* ---------- masonry ----------
     卡片是客户端 JS 动态创建的,不会带 Astro 作用域属性,
     因此这些规则必须写成 :global 才能生效。
     位置由 initMasonry 计算(最短列绝对定位),实现上下密铺。 */
  .masonry {
    position: relative;
  }

  :global(.masonry-card) {
    position: relative;
    display: block;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--surface-2);
  }

  /* 高度由正常文档流中的 media 层决定,保证卡片高度与图片区域完全一致,
     文字永远不会跑到图片外 */
  :global(.masonry-media) {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }

  :global(.masonry-img),
  :global(.masonry-fallback) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.masonry-img) {
    display: block;
  }
  :global(.masonry-fallback) {
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 45%),
      linear-gradient(135deg, var(--surface-2), var(--surface));
  }

  :global(.masonry-card:hover .masonry-img) {
    transform: scale(1.06);
  }

  :global(.masonry-veil) {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* 阴影只落到左下角日期/标题之间:更靠下、更淡 */
    background: linear-gradient(180deg, transparent 72%, rgba(10, 12, 16, 0.32));
  }

  :global(.masonry-caption) {
    position: absolute;
    z-index: 2;
    inset: auto 12px 12px; /* 角落显示文章名、日期 */
    max-width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  :global(.masonry-caption time) {
    font-size: 0.7rem;
    opacity: 0.85;
  }
  :global(.masonry-title) {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  :global(.masonry-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  :global(.masonry-chips .chip) {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .masonry-empty {
    margin: 0;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-faint);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  @media (max-width: 900px) {
    .archive-panel {
      grid-template-columns: 1fr;
    }
    .archive-side {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .filter-group {
      flex: 1 1 220px;
    }
  }
</style>
