
---
import { t } from '../i18n';
import type { Language } from '../types';
import { archiveHref, archiveCategoryHref } from '../utils/paths';
import CategoryPills from './CategoryPills.astro';

export interface ArchivePostData {
  id: string;
  href: string;
  title: string;
  category: string;
  tags: string[];
  date: string;
  year: number;
  month: number;
  day: number;
  image?: string;
  ratio: string;
}

interface Props {
  lang: Language;
  posts: ArchivePostData[];
  categories: [string, number][];
}

const { lang, posts, categories } = Astro.props;

// 按年份分组
const timeline = posts.reduce<Map<number, ArchivePostData[]>>((map, post) => {
  const list = map.get(post.year) ?? [];
  list.push(post);
  map.set(post.year, list);
  return map;
}, new Map());

const years = [...timeline.keys()].sort((a, b) => b - a);
---

<div class="archive-panel" data-archive-panel>
  <!-- 分类按钮 -->
  <CategoryPills
    {lang}
    {categories}
    allHref={archiveHref(lang)}
    hrefForCategory={(category) => archiveCategoryHref(lang, category)}
  />

  <!-- 时间线 -->
  <div class="timeline" data-timeline>
    {
      years.map((year) => (
        <section class="timeline-year">
          <h2 class="timeline-year-heading">{year}</h2>

          <ul class="timeline-list">
            {
              (timeline.get(year) ?? []).map((post) => (
                <li class="timeline-item" data-category={post.category}>
                  <time class="timeline-date">
                    {post.month}/{post.day}
                  </time>

                  <a class="timeline-title" href={post.href}>
                    {post.title}
                  </a>

                  <span class="timeline-meta">
                    {post.tags.map((tagName) => (
                      <span class="chip chip--plain">{tagName}</span>
                    ))}

                    <a
                      class="chip chip-link"
                      href={archiveCategoryHref(lang, post.category)}
                      data-category-link={post.category}
                    >
                      {post.category}
                    </a>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </div>

  <div class="masonry" data-masonry hidden></div>
  <p class="masonry-empty" data-masonry-empty hidden>
    {t(lang, 'archive.noMatch')}
  </p>
</div>

<script>
  // 明确指定 panel 是 HTML 元素
  const panel = document.querySelector<HTMLElement>('[data-archive-panel]');

  if (panel) {
    // 分类按钮
    const categoryLinks = [
      ...panel.querySelectorAll<HTMLAnchorElement>(
        '.archive-categories .category-pill'
      )
    ];

    // 年份区块
    const yearSections = [
      ...panel.querySelectorAll<HTMLElement>('.timeline-year')
    ];

    const knownCategories = new Set(
      categoryLinks
        .map((link) => link.dataset.category || '')
        .filter(Boolean)
    );

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    let selectedCategory = '';
    let animationVersion = 0;

    // 从 URL 读取分类
    function readCategoryFromURL(): string {
      const params = new URLSearchParams(window.location.search);
      const category = params.get('category') || '';

      return knownCategories.has(category) ? category : '';
    }

    // 更新 URL，不刷新页面
    function updateURL(): void {
      const url = new URL(window.location.href);

      if (selectedCategory) {
        url.searchParams.set('category', selectedCategory);
      } else {
        url.searchParams.delete('category');
      }

      history.replaceState({}, '', url);
    }

    // 更新分类按钮状态
    function updateActiveState(): void {
      categoryLinks.forEach((link) => {
        const category = link.dataset.category || '';
        const active = category === selectedCategory;

        link.classList.toggle('is-active', active);

        if (active) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    // 判断文章是否符合当前分类
    function shouldShowItem(item: HTMLLIElement): boolean {
      const category = item.dataset.category || '';
      return !selectedCategory || category === selectedCategory;
    }

    // 取消元素正在执行的动画
    function cancelAnimations(element: HTMLElement): void {
      element.getAnimations().forEach((animation: Animation) => {
        animation.cancel();
      });
    }

    // 获取元素的实际高度和垂直间距
    function getVerticalMetrics(element: HTMLElement) {
      const style = getComputedStyle(element);

      return {
        height: element.getBoundingClientRect().height,
        paddingTop: parseFloat(style.paddingTop) || 0,
        paddingBottom: parseFloat(style.paddingBottom) || 0,
        marginTop: parseFloat(style.marginTop) || 0,
        marginBottom: parseFloat(style.marginBottom) || 0,
      };
    }

    // 通用收缩动画
    function collapseElement(
      element: HTMLElement,
      animate: boolean,
      duration = 300
    ): Promise<void> {
      if (element.hidden) return Promise.resolve();

      if (!animate) {
        element.hidden = true;
        return Promise.resolve();
      }

      const metrics = getVerticalMetrics(element);

      const animation = element.animate(
        [
          {
            height: `${metrics.height}px`,
            paddingTop: `${metrics.paddingTop}px`,
            paddingBottom: `${metrics.paddingBottom}px`,
            marginTop: `${metrics.marginTop}px`,
            marginBottom: `${metrics.marginBottom}px`,
            opacity: 1,
            overflow: 'hidden',
            boxSizing: 'border-box',
          },
          {
            height: '0px',
            paddingTop: '0px',
            paddingBottom: '0px',
            marginTop: '0px',
            marginBottom: '0px',
            opacity: 0,
            overflow: 'hidden',
            boxSizing: 'border-box',
          }
        ],
        {
          duration,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'forwards',
        }
      );

      return animation.finished
        .catch(() => {})
        .then(() => {
          // 只有动画正常结束才隐藏
          if (animation.playState === 'finished') {
            element.hidden = true;
          }

          cancelAnimations(element);
        });
    }

    // 通用展开动画
    function expandElement(
      element: HTMLElement,
      animate: boolean,
      duration = 340
    ): Promise<void> {
      element.hidden = false;

      if (!animate) {
        return Promise.resolve();
      }

      // 强制浏览器完成一次布局，确保测量的是展开后的自然高度
      element.getBoundingClientRect();

      const metrics = getVerticalMetrics(element);

      const animation = element.animate(
        [
          {
            height: '0px',
            paddingTop: '0px',
            paddingBottom: '0px',
            marginTop: '0px',
            marginBottom: '0px',
            opacity: 0,
            overflow: 'hidden',
            boxSizing: 'border-box',
          },
          {
            height: `${metrics.height}px`,
            paddingTop: `${metrics.paddingTop}px`,
            paddingBottom: `${metrics.paddingBottom}px`,
            marginTop: `${metrics.marginTop}px`,
            marginBottom: `${metrics.marginBottom}px`,
            opacity: 1,
            overflow: 'hidden',
            boxSizing: 'border-box',
          }
        ],
        {
          duration,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'none',
        }
      );

      return animation.finished
  .then(() => undefined)
  .catch(() => undefined);
    }

    // 文章条目收缩
    function collapseItem(
      item: HTMLLIElement,
      animate: boolean
    ): Promise<void> {
      return collapseElement(item, animate, 280);
    }

    // 文章条目展开
    function expandItem(
      item: HTMLLIElement,
      animate: boolean
    ): Promise<void> {
      return expandElement(item, animate, 340);
    }

    // 年份区块收缩：年份标题和文章整体一起收缩
    function collapseYearSection(
      section: HTMLElement,
      animate: boolean
    ): Promise<void> {
      return collapseElement(section, animate, 320);
    }

    // 年份区块展开
    function expandYearSection(
      section: HTMLElement,
      animate: boolean
    ): Promise<void> {
      return expandElement(section, animate, 360);
    }

    // 初始化筛选状态
    function initializeFilter(): void {
      updateActiveState();

      yearSections.forEach((section) => {
        const items = [
          ...section.querySelectorAll<HTMLLIElement>('.timeline-item')
        ];

        const visibleItems = items.filter(shouldShowItem);
        const sectionVisible = visibleItems.length > 0;

        section.hidden = !sectionVisible;
        section.dataset.filteredOut = String(!sectionVisible);

        items.forEach((item) => {
          const visible = shouldShowItem(item);

          item.hidden = !visible;
          item.dataset.filteredOut = String(!visible);
        });
      });
    }

    // 分类筛选
    async function filterPosts(animate = true): Promise<void> {
      const currentVersion = ++animationVersion;
      const useAnimation = animate && !reduceMotion;

      updateActiveState();
      updateURL();

      // 取消所有旧动画
      yearSections.forEach((section) => {
        cancelAnimations(section);

        section
          .querySelectorAll<HTMLLIElement>('.timeline-item')
          .forEach((item) => cancelAnimations(item));
      });

      const tasks: Promise<void>[] = [];

      for (const section of yearSections) {
        const sectionItems = [
          ...section.querySelectorAll<HTMLLIElement>('.timeline-item')
        ];

        const matchingItems = sectionItems.filter(shouldShowItem);
        const sectionShouldShow = matchingItems.length > 0;

        const wasSectionHidden = section.hidden;
        const wasSectionFilteredOut =
          section.dataset.filteredOut === 'true';

        section.dataset.filteredOut = String(!sectionShouldShow);

        // ----------------------------------------
        // 情况 A：该年份没有任何符合条件的文章
        // 直接收缩整个年份区块
        // ----------------------------------------
        if (!sectionShouldShow) {
          if (!wasSectionHidden && !wasSectionFilteredOut) {
            tasks.push(collapseYearSection(section, useAnimation));
          } else {
            section.hidden = true;
          }

          sectionItems.forEach((item) => {
            item.hidden = true;
            item.dataset.filteredOut = 'true';
          });

          continue;
        }

        // ----------------------------------------
        // 情况 B：该年份原本被隐藏，现在需要恢复
        // 先恢复文章的目标状态，再展开整个年份区块
        // ----------------------------------------
        if (wasSectionHidden || wasSectionFilteredOut) {
          section.hidden = false;

          sectionItems.forEach((item) => {
            const visible = shouldShowItem(item);

            item.hidden = !visible;
            item.dataset.filteredOut = String(!visible);
          });

          tasks.push(expandYearSection(section, useAnimation));
          continue;
        }

        // ----------------------------------------
        // 情况 C：年份仍然存在
        // 只对不匹配的文章做动画
        // ----------------------------------------
        for (const item of sectionItems) {
          const visible = shouldShowItem(item);
          const wasFilteredOut =
            item.dataset.filteredOut === 'true';

          item.dataset.filteredOut = String(!visible);

          if (visible) {
            if (wasFilteredOut || item.hidden) {
              tasks.push(expandItem(item, useAnimation));
            }
          } else {
            if (!wasFilteredOut && !item.hidden) {
              tasks.push(collapseItem(item, useAnimation));
            }
          }
        }
      }

      await Promise.all(tasks);

      // 避免旧动画覆盖最新的筛选结果
      if (currentVersion !== animationVersion) return;

      // 最终校准状态
      yearSections.forEach((section) => {
        const sectionItems = [
          ...section.querySelectorAll<HTMLLIElement>('.timeline-item')
        ];

        const visibleItems = sectionItems.filter(shouldShowItem);
        const sectionVisible = visibleItems.length > 0;

        section.hidden = !sectionVisible;
        section.dataset.filteredOut = String(!sectionVisible);

        sectionItems.forEach((item) => {
          const visible = shouldShowItem(item);

          item.hidden = !visible;
          item.dataset.filteredOut = String(!visible);

          cancelAnimations(item);
        });

        cancelAnimations(section);
      });
    }

    // 顶部分类按钮
    categoryLinks.forEach((link) => {
      link.addEventListener('click', (event: MouseEvent) => {
        event.preventDefault();

        const category = link.dataset.category || '';

        selectedCategory =
          category === selectedCategory ? '' : category;

        filterPosts(true);
      });
    });

    // 文章右侧分类标签
    panel
      .querySelectorAll<HTMLAnchorElement>('[data-category-link]')
      .forEach((link) => {
        link.addEventListener('click', (event: MouseEvent) => {
          event.preventDefault();

          const category = link.dataset.categoryLink || '';

          selectedCategory =
            category === selectedCategory ? '' : category;

          filterPosts(true);
        });
      });

    // 浏览器前进、后退
    window.addEventListener('popstate', () => {
      selectedCategory = readCategoryFromURL();
      filterPosts(false);
    });

    // 初次加载
    selectedCategory = readCategoryFromURL();
    initializeFilter();
  }
</script>

<style>
  /* 页面背景 */
  :global(html) {
    min-height: 100%;
    background-color: var(--bg);
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    background-color: var(--bg);
  }

  .archive-panel {
    max-width: 980px;
    min-height: calc(100vh - 10rem);
    margin: 1.5rem auto 0;
    padding-bottom: 3rem;
  }

  .chip-link {
    text-decoration: none;
    cursor: pointer;
  }

  .chip-link:hover {
    background: color-mix(in srgb, var(--sky) 24%, transparent);
    color: var(--hover);
  }

  /* 时间线 */
  .timeline {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    padding-left: 26px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      rgba(42, 184, 240, 0.99) 0%,
      rgba(42, 184, 240, 0.73) 30%,
      rgba(42, 184, 240, 0.48) 60%,
      rgba(42, 184, 240, 0.0) 100%
    );
  }

  .timeline-year {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .timeline-year-heading {
    position: relative;
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  /* 年份节点 */
  .timeline-year-heading::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--sky);
    border: 2px solid var(--bg);
    box-sizing: border-box;
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  /* 文章节点 */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -25px;
    top: 50%;
    transform: translateY(-50%) scale(0);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--sky);
    box-shadow: 0 0 0 0 rgba(42, 168, 240, 0);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .timeline-item:hover {
    background: var(--surface-2);
  }

  .timeline-item:hover::before {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    box-shadow:
      0 0 0 3px rgba(42, 168, 240, 0.16),
      0 0 10px rgba(42, 168, 240, 0.45);
  }

  .timeline-date {
    flex: none;
    width: 3.2em;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .timeline-title {
    flex: 1;
    font-weight: 600;
    color: var(--text);
  }

  .timeline-title:hover {
    color: var(--hover);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* 隐藏状态 */
  .timeline-item[hidden],
  .timeline-year[hidden] {
    display: none !important;
  }

  /* Masonry 保留原有结构 */
  .masonry {
    position: relative;
  }

  :global(.masonry-card) {
    position: relative;
    display: block;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: var(--surface-2);
  }

  :global(.masonry-media) {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }

  :global(.masonry-img),
  :global(.masonry-fallback) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.masonry-img) {
    display: block;
  }

  :global(.masonry-fallback) {
    background:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 45%),
      linear-gradient(135deg, var(--surface-2), var(--surface));
  }

  :global(.masonry-card:hover .masonry-img) {
    transform: scale(1.06);
  }

  :global(.masonry-veil) {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      transparent 72%,
      rgba(10, 12, 16, 0.32)
    );
  }

  :global(.masonry-caption) {
    position: absolute;
    z-index: 2;
    inset: auto 12px 12px;
    max-width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  :global(.masonry-caption time) {
    font-size: 0.7rem;
    opacity: 0.85;
  }

  :global(.masonry-title) {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  :global(.masonry-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }

  :global(.masonry-chips .chip) {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .masonry-empty {
    margin: 0;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--text-faint);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-pill,
    .timeline-item {
      transition: none;
    }
  }
</style>
