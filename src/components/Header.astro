---
import { siteConfig } from '../site.config';
import { t, localize } from '../i18n';
import type { Language } from '../types';
import { withBase } from '../utils/paths';
import { panelIcon } from '../icons';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;

type Href = string | ((l: Language) => string);

const resolveHref = (href: Href | undefined) =>
  href === undefined ? '#' : withBase(typeof href === 'function' ? href(lang) : href);

const isActive = (href: string) =>
  !href.startsWith('http') && (pathname === href || pathname.startsWith(`${href}/`));

const home = withBase(`/${lang}`);

/** 是否当前页正好在该条目或其子项上。 */
function entryActive(href: string | undefined, childHrefs: string[]): boolean {
  const own = href ? isActive(href) : false;
  // "首页" 的 isActive 会匹配 site 根,需排除,避免所有页面都高亮首页。
  const self = href === home ? pathname === home : own;
  return self || childHrefs.some(isActive);
}

/* ---------------------------------------------------------
 * 顶部导航(支持一层分组:带 children 的条目渲染成可展开块)
 * --------------------------------------------------------- */

type RawChild = {
  label: unknown;
  href?: Href;
  external?: boolean;
  icon?: string;
};

type RawItem = RawChild & { children?: readonly RawChild[] };

const navItems = (siteConfig.nav as readonly RawItem[]).map((item) => {
  const children = (item.children ?? []).map((child) => {
    const href = resolveHref(child.href);
    return {
      label: localize(child.label as never, lang),
      href,
      external: Boolean(child.external),
      // 面板内用彩色图标(没有彩色变体时自动退回单色)
      icon: panelIcon(child.icon ?? ''),
      active: isActive(href),
    };
  });

  const href = item.href ? resolveHref(item.href) : undefined;

  return {
    label: localize(item.label as never, lang),
    href,
    external: Boolean(item.external),
    // 导航栏也改用彩色图标(统一走 panelIcon:优先 color/ 变体)
    icon: item.icon ? panelIcon(item.icon) : '',
    children,
    active: entryActive(href, children.map((c) => c.href)),
  };
});

/* ---------------------------------------------------------
 * 搜索图标右边的可展开块(原页脚条目)
 * --------------------------------------------------------- */

const menuItems = siteConfig.menu.map((item) => ({
  label: localize(item.label, lang),
  href: resolveHref(item.href),
  external: typeof item.href === 'string' && /^https?:\/\//.test(item.href),
  icon: panelIcon(item.icon),
  copyValue: 'wechatId' in item ? item.wechatId : undefined,
}));

const hasMenu = menuItems.length > 0;
---

<header class="site-header" data-header>
  <div class="header-inner">
    <nav class="site-nav" id="site-nav" data-nav>
      <ul>
        {
          navItems.map((item) => (
            <li class:list={{ 'has-children': item.children.length > 0 }}>
              {item.children.length > 0 ? (
                /* 与「链接」块完全同构:容器(这里是 li / 那里是 .header-menu)
                   直接包住 button + 面板,所以 menuOf() 能用同一种方式取到面板。
                   不要在 button 外面再加包裹层,否则面板就不再是它的兄弟节点。 */
                <button
                  class:list={[
                    'icon-btn',
                    'icon-btn--label',
                    'nav-group-btn',
                    { 'is-active': item.active },
                  ]}
                  type="button"
                  aria-label={item.label}
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-nav-group
                >
                  {item.icon && <span class="nav-icon" set:html={item.icon} />}
                  <span class="nav-label">{item.label}</span>
                </button>
              ) : (
                <a
                  class:list={['nav-link', { 'is-active': item.active }]}
                  href={item.href}
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {item.icon && <span class="nav-icon" set:html={item.icon} />}
                  <span class="nav-label">{item.label}</span>
                </a>
              )}

              {item.children.length > 0 && (
                <ul class="nav-submenu nav-submenu--icons" data-nav-menu hidden>
                  {item.children.map((child) => (
                    <li>
                      <a
                        class:list={['nav-submenu-link', { 'is-active': child.active }]}
                        href={child.href}
                        aria-label={child.label}
                        {...(child.external
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        {child.icon && <span class="nav-icon" set:html={child.icon} />}
                        <span class="sr-only">{child.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {
        hasMenu && (
          <div class="header-menu" data-nav-group-wrap>
            <button
              class="icon-btn icon-btn--label"
              type="button"
              aria-label={t(lang, 'menu.open')}
              aria-expanded="false"
              aria-haspopup="true"
              data-nav-group
            >
              <span class="nav-icon" set:html={panelIcon('link')} />
              <span class="nav-label">{t(lang, 'menu.label')}</span>
            </button>

            {/* 图标-only 面板:展开后只出现图标(文字仅供读屏) */}
            <ul class="nav-submenu nav-submenu--icons" data-nav-menu hidden>
              {menuItems.map((item) =>
                item.copyValue ? (
                  <li>
                    <button
                      class="nav-submenu-link"
                      type="button"
                      aria-label={item.label}
                      data-copy-wechat
                      data-copy-value={item.copyValue}
                    >
                      <span class="nav-icon" set:html={item.icon} />
                      <span class="sr-only">{item.label}</span>
                    </button>
                  </li>
                ) : (
                  <li>
                    <a
                      class="nav-submenu-link"
                      href={item.href}
                      aria-label={item.label}
                      {...(item.external
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      <span class="nav-icon" set:html={item.icon} />
                      <span class="sr-only">{item.label}</span>
                    </a>
                  </li>
                )
              )}
            </ul>
          </div>
        )
      }

      <LanguagePicker lang={lang} pathname={pathname} />

      <button
        class="icon-btn"
        type="button"
        aria-label={t(lang, 'search.open')}
        data-search-open
      >
        <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="5.6" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="m13.4 13.4 3.8 3.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>

      <ThemeToggle lang={lang} />
    </div>

    <button class="hamburger" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<div class="copy-toast" data-copy-toast role="status"></div>

<script>
  /* ---------------------------------------------------------
   * 汉堡菜单开合
   * --------------------------------------------------------- */
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  /* ---------------------------------------------------------
   * 可向下展开的块(顶栏导航分组 + 搜索右侧条目块)
   *
   * 点击父项切换;点击别处或 Esc 关闭;点击面板内的链接后一并关闭。
   * --------------------------------------------------------- */
  const groupButtons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-nav-group]'),
  ];

  /**
   * 找到触发块对应的面板。
   * 两个块的 DOM 形状一致:容器(li.has-children / .header-menu)里同时有
   * button 和 [data-nav-menu],所以 button 的父元素就是那个容器。
   */
  const menuOf = (btn: HTMLElement) =>
    btn.parentElement?.querySelector<HTMLElement>('[data-nav-menu]') ?? null;

  const closeGroups = (except?: HTMLElement) => {
    groupButtons.forEach((btn) => {
      if (btn === except) return;
      btn.setAttribute('aria-expanded', 'false');
      menuOf(btn)?.setAttribute('hidden', '');
    });
  };

  const bindGroups = () => {
    closeGroups();

    groupButtons.forEach((btn) => {
      if (btn.dataset.groupReady === 'true') return;
      btn.dataset.groupReady = 'true';

      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const menu = menuOf(btn);
        if (!menu) return;
        // 该块是导航分组时,先收起可能展开的其它块
        closeGroups(btn);
        const willOpen = menu.hasAttribute('hidden');
        if (willOpen) menu.removeAttribute('hidden');
        else menu.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', String(willOpen));
      });
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest('[data-nav-group-wrap], .has-children')) return;
    closeGroups();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeGroups();
  });

  // 面板内的链接跳转后,把面板收起(返回上一页时不会残留展开状态)
  document.querySelectorAll<HTMLElement>('[data-nav-menu] a').forEach((link) => {
    link.addEventListener('click', () => closeGroups());
  });

  bindGroups();

  /* ---------------------------------------------------------
   * 毛玻璃胶囊:滚动一定距离后切换 "not-top"(加底色/边框/阴影),
   * 始终吸顶显示,不随下滑淡出
   * --------------------------------------------------------- */
  const header = document.querySelector<HTMLElement>('.site-header');

  /**
   * 展开块不常驻:一旦页面滚动就自动收回。
   * 用与 not-top 相同的 20px 阈值,避免"刚下滑一点点面板还挂着"的割裂感。
   * 每次滚动只判断一次、只在需要时改 DOM,不会影响滚动性能。
   */
  const syncGroups = () => {
    if (window.scrollY <= 20) return;
    if (!groupButtons.some((btn) => btn.getAttribute('aria-expanded') === 'true')) return;
    closeGroups();
  };

  const syncScroll = () => {
    if (!header) return;
    header.classList.toggle('not-top', window.scrollY > 20);
    syncGroups();
    syncOverHero();
  };

  // 悬浮在大图上方时文字用白色(其它情况用普通导航色)
  const syncOverHero = () => {
    if (!header) return;
    const hero = document.querySelector('.hero');
    if (!hero) {
      header.classList.remove('is-over-hero');
      return;
    }
    const heroHeight = hero.getBoundingClientRect().height;
    header.classList.toggle('is-over-hero', window.scrollY < heroHeight - 40);
  };

  window.addEventListener('scroll', syncScroll, { passive: true });
  syncScroll();

  document.addEventListener('astro:page-load', () => {
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    bindGroups();
    syncScroll();
  });
</script>

<style>
  /* 灵动岛胶囊:悬浮吸顶、居中、宽度随内容收缩 */
  .site-header {
    position: fixed;
    top: 8px;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    width: auto;
    max-width: 94vw;
    margin: 0;
    z-index: 40;
    display: block;
    /* 顶部状态:图标+文字全显示,略低的毛玻璃高度 */
    height: 58px;
    box-sizing: border-box;
    /* 初始无底色 */
    background: transparent;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      height 0.25s ease,
      background-color 0.2s,
      border-color 0.15s,
      box-shadow 0.2s;
  }

  /* 滚动后:毛玻璃胶囊(带底色/边框/阴影),并缩小为图标为主 */
  .site-header.not-top {
    height: 52px;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-color: var(--border);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.02),
      0 10px 30px -3px rgba(0, 0, 0, 0.08),
      0 4px 6px -4px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* 深色模式下底色更深些 */
  html[data-theme='dark'] .site-header.not-top {
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    /* 四大块(导航 / 链接 / 搜索·语言·主题 / 汉堡)之间的距离 */
    gap: 8px;
    height: 100%;
    padding: 0 10px;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    /* 块与块之间的距离(与 .header-actions 保持一致) */
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 导航项:默认只显示图标,悬停整条胶囊(或当前页)时文字滑出 */
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 与 .icon-btn--label 统一:图标与文字之间固定 5px */
    gap: 5px;
    padding: 10px 12px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    color: var(--nav-text);
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav-icon {
    display: inline-flex;
    flex: none;
  }
  .nav-icon :global(svg) {
    display: block;
  }
  .nav-label {
    display: inline-block;
    max-width: 120px;
    opacity: 1;
    overflow: hidden;
    white-space: nowrap;
    /* 文字只在"收起/滑出"时靠 margin-left 做动画,静止间距由上面的 gap 提供;
       因此这里必须为 0,否则静止时会变成 gap + margin 双重间距。 */
    margin-left: 0;
    transition:
      max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s ease,
      margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* 滚动缩小后:只显示图标,文字收起;悬停胶囊时再次滑出 */
  .site-header.not-top .nav-label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
  }
  .site-header.not-top:hover .nav-label {
    max-width: 120px;
    opacity: 1;
    margin-left: 0;
  }
  /* 当前页:天蓝高亮(顶部状态文字常显) */
  .nav-link.is-active {
    color: var(--sky);
    background: color-mix(in srgb, var(--sky) 15%, transparent);
  }
  .nav-link.is-active .nav-label {
    max-width: 120px;
    opacity: 1;
    margin-left: 0;
  }
  /* 滚动缩小后:即使当前页也收起文字,随悬停滑出 */
  .site-header.not-top .nav-link.is-active .nav-label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
  }
  .site-header.not-top:hover .nav-link.is-active .nav-label {
    max-width: 120px;
    opacity: 1;
    margin-left: 0;
  }
  .nav-link:hover {
    color: var(--sky);
    background: color-mix(in srgb, var(--sky) 10%, transparent);
  }

  /* ---------- 分组父项(可向下展开的块) ---------- */

  .site-nav li.has-children,
  .header-menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 两个触发块都是 button,统一清掉浏览器默认外观 */
  .nav-group-btn {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .nav-group-btn.is-active {
    color: var(--sky);
    background: color-mix(in srgb, var(--sky) 15%, transparent);
  }

  /* ---------- 顶栏展开块的触发按钮(「生活」与「链接」共用同一套) ---------- */

  /* 高度 38px、图标 + 文字。文字字号/字重/行高与 .nav-link 对齐,保证两种
     触发块在顶栏里看起来完全一致。 */
  .icon-btn--label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 38px;
    padding: 0 12px;
    /* 与 .nav-link 统一:图标与文字之间固定 5px */
    gap: 5px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  /* 与导航文字同一套收起/滑出行为:滚动后只留图标,悬停胶囊时文字滑出
     (静止间距由 gap 提供,margin-left 只负责动画,故恒为 0) */
  .site-header.not-top .icon-btn--label .nav-label {
    max-width: 0;
    opacity: 0;
    margin-left: 0;
  }
  .site-header.not-top:hover .icon-btn--label .nav-label {
    max-width: 96px;
    opacity: 1;
    margin-left: 0;
  }
  /* 窄屏:直接只留图标,避免把胶囊挤宽(语言/主题按钮的样式保持不变) */
  @media (max-width: 700px) {
    .icon-btn--label {
      padding: 0;
      width: 38px;
    }
    .icon-btn--label .nav-label {
      display: none;
    }
  }

  /* ---------- 向下弹出的面板 ---------- */

  /* 与顶栏"同源但不同款":
     同样是一枚胶囊 + 同色系描边 + 毛玻璃,但底色更实一些(--surface 混 --bg)、
     模糊更强(14px vs 顶栏 12px)、圆角收小到 --radius-lg,让它是"顶栏延伸出来的
     一层",而不是顶栏的复制品。 */
  .site-header .nav-submenu {
    position: absolute;
    top: calc(100% + 10px);
    /* 与上方触发块水平居中对齐 */
    left: 50%;
    translate: -50% 0;
    z-index: 45;
    display: flex;
    /* 竖向排列 */
    flex-direction: column;
    align-items: center;
    gap: 4px;
    /* 宽度自适应内容;上限同时防止"居中于触发块"时溢出视口左右边缘 */
    width: max-content;
    max-width: min(80vw, calc(100vw - 24px), 240px);
    margin: 0;
    padding: 6px;
    list-style: none;
    background: color-mix(in srgb, var(--surface) 80%, var(--bg));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-strong);
    backdrop-filter: blur(14px) saturate(1.35);
    -webkit-backdrop-filter: blur(14px) saturate(1.35);
    animation: nav-submenu-in 0.16s ease-out;
  }
  .site-header .nav-submenu[hidden] {
    display: none;
  }
  @keyframes nav-submenu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header .nav-submenu {
      animation: none;
    }
  }

  /* 面板条目:图标-only 的圆形按钮,竖向一列 */
  .site-header .nav-submenu-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }
  .site-header .nav-submenu-link .nav-icon {
    display: block;
  }
  .site-header .nav-submenu-link :global(svg) {
    display: block;
  }
  .site-header .nav-submenu-link:hover {
    background: color-mix(in srgb, var(--sky) 12%, transparent);
    transform: scale(1.08);
  }
  .site-header .nav-submenu-link.is-active {
    background: color-mix(in srgb, var(--sky) 18%, transparent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    /* 与 .site-nav ul 统一:块与块之间的距离 */
    gap: 4px;
  }

  .hamburger {
    display: none;
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--nav-text);
    width: 38px;
    height: 38px;
    place-items: center;
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .hamburger:hover {
    color: var(--sky);
    background: color-mix(in srgb, var(--sky) 10%, transparent);
  }

  @media (max-width: 980px) {
    .hamburger {
      display: grid;
    }

    .site-nav {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: 92vw;
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-strong);
      padding: 6px;
      display: none;
    }
    .site-nav.is-open {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }
    .nav-link {
      display: flex;
      justify-content: flex-start;
      width: 100%;
