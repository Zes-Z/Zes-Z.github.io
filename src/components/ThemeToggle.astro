---
import { t } from '../i18n';
import type { Language } from '../types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<theme-toggle
  data-theme-trigger-root
  data-label-light={t(lang, 'theme.light')}
  data-label-dark={t(lang, 'theme.dark')}
>
  <button
    class="icon-btn"
    type="button"
    aria-label={t(lang, 'theme.dark')}
    title={t(lang, 'theme.dark')}
    data-theme-toggle-btn
  >
    <span class="theme-icon" data-icon="sun" hidden>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M15.8 4.2l-1.4 1.4M5.6 14.4l-1.4 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </span>
    <span class="theme-icon" data-icon="moon" hidden>
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M16.6 12.5A7.6 7.6 0 0 1 7.5 3.4a7.6 7.6 0 1 0 9.1 9.1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</theme-toggle>

<script>
  type ThemeMode = 'light' | 'dark';
  const STORAGE_KEY = 'zest-theme';
  const MEDIA = window.matchMedia('(prefers-color-scheme: dark)');

  const root = document.documentElement;
  const LABELS = { light: 'sun', dark: 'moon' } as const;

  function storedMode(): ThemeMode | null {
    const value = localStorage.getItem(STORAGE_KEY);
    if (value === 'light' || value === 'dark') return value;
    return null;
  }

  function resolvedMode(): ThemeMode {
    return storedMode() ?? (MEDIA.matches ? 'dark' : 'light');
  }

  function apply(mode: ThemeMode) {
    root.setAttribute('data-theme', mode);
    root.setAttribute('data-code-scheme', mode === 'dark' ? 'dark' : 'light');
    const meta = document.querySelector<HTMLMetaElement>("meta[name='theme-color']");
    if (meta) meta.content = mode === 'dark' ? '#101218' : '#eef6ef';
    // 切换时短暂启用过渡,让颜色柔和变化;页面加载/导航不触发
    root.classList.add('theme-anim');
    window.setTimeout(() => root.classList.remove('theme-anim'), 420);
    syncIcon();
  }

  function syncIcon() {
    const mode = resolvedMode();
    document.querySelectorAll<HTMLElement>('theme-toggle').forEach((toggle) => {
      toggle.querySelectorAll<HTMLElement>('[data-icon]').forEach((el) => {
        el.hidden = el.dataset.icon !== LABELS[mode];
      });
      const btn = toggle.querySelector<HTMLButtonElement>('[data-theme-toggle-btn]');
      if (btn) {
        const label = mode === 'dark' ? toggle.dataset.labelDark : toggle.dataset.labelLight;
        btn.setAttribute('aria-label', label ?? '');
        btn.title = label ?? '';
      }
    });
  }

  function setup() {
    document.querySelectorAll<HTMLElement>('theme-toggle').forEach((toggle) => {
      if (toggle.dataset.ready === 'true') return;
      toggle.dataset.ready = 'true';
      const btn = toggle.querySelector<HTMLButtonElement>('[data-theme-toggle-btn]');
      if (!btn) return;
      // 单击切换:明亮 ⇄ 暗黑
      btn.addEventListener('click', () => {
        const next = resolvedMode() === 'dark' ? 'light' : 'dark';
        localStorage.setItem(STORAGE_KEY, next);
        apply(next);
      });
    });
    syncIcon();
  }

  MEDIA.addEventListener('change', () => {
    if (!storedMode()) apply(resolvedMode());
  });

  window.addEventListener('storage', (event) => {
    if (event.key === STORAGE_KEY) apply(resolvedMode());
  });

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  theme-toggle {
    display: inline-flex;
  }

  .theme-icon {
    display: grid;
    place-items: center;
  }
  .theme-icon[hidden] {
    display: none;
  }
</style>
