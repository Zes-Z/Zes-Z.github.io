---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import PinnedGrid from './PinnedGrid.astro';
import { siteConfig, siteSubtitle } from '../../SiteConfig';
import { t, localize } from '../i18n';
import type { Language } from '../types';
import { getPinnedPosts, slugOf } from '../utils/posts';
import { postHref } from '../utils/paths';
import { postImageCandidates } from '../utils/images';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

/** 主卡与缩略卡共用响应式 AVIF 候选，按实际显示宽度选图。 */
const PINNED_WIDTHS = [320, 480, 720, 1080, 1440];

const pinned = await getPinnedPosts(lang);
const pinnedCards = await Promise.all(
  pinned.map(async (post, index) => {
    const slug = slugOf(post, lang);
    const cover = await postImageCandidates(
      slug,
      post.data.postImage,
      PINNED_WIDTHS,
      index === 0 ? 720 : 480,
    );
    return {
      href: postHref(lang, slug),
      title: post.data.title,
      category: post.data.category,
      date: post.data.pubDate
        ? `${post.data.pubDate.getFullYear()}/${post.data.pubDate.getMonth() + 1}/${post.data.pubDate.getDate()}`
        : '',
      datetime: post.data.pubDate?.toISOString().slice(0, 10),
      image: cover?.src,
      original: cover?.original,
      srcset: cover?.srcset,
      sizes: index === 0
        ? '(max-width: 700px) 90vw, (max-width: 1200px) 62vw, 710px'
        : '(max-width: 520px) 90vw, (max-width: 700px) 43vw, (max-width: 1200px) 29vw, 330px',
    };
  })
);

const heroSubtitleText = siteSubtitle();
const heroSubtitle = heroSubtitleText ? localize(heroSubtitleText, lang) : undefined;
---

<BaseLayout lang={lang} fullWidth heroFont={siteConfig.heroFont}>
<Hero
  images={[...siteConfig.heroImages]}
  height="full"
  position="bottom-left"
  welcome={siteConfig.welcome.map((item) => ({
    text: item.text,
    href: item.href(lang),
  }))}
  rightTitle={siteConfig.aboutZes.text}
  rightTitleHref={siteConfig.aboutZes.href(lang)}
  subtitle={heroSubtitle}
  interval={siteConfig.heroInterval}
/>

  {
    pinnedCards.length > 0 && (
      <section class="home-section container-x">
        <div class="home-section-head">
          <h2 class="section-title">{t(lang, 'home.pinned')}</h2>

        </div>
        <PinnedGrid cards={pinnedCards} />
      </section>
    )
  }
</BaseLayout>

<style>
  .home-section {
    margin-top: clamp(2.1rem, 0vw, 2.7rem);
  }
  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .home-section-head .section-title {
    margin-bottom: 1.25rem;
  }
  .all-posts-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sky);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .all-posts-link:hover {
    color: var(--hover);
  }
</style>
