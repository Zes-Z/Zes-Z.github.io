---
import type { Language } from '../types';

interface AdjacentItem {
  href: string;
  title: string;
  description?: string;
  date?: string;
  datetime?: string;
  category?: string;
  image?: string;
}

interface Props {
  lang: Language;
  prev?: AdjacentItem;
  next?: AdjacentItem;
}

const { lang, prev, next } = Astro.props;
const words = {
  zh: { heading: '继续阅读', prev: '上一篇', next: '下一篇' },
  en: { heading: 'Continue reading', prev: 'Previous post', next: 'Next post' },
  ja: { heading: '続きを読む', prev: '前の記事', next: '次の記事' },
}[lang];

const cards: {
  item: AdjacentItem;
  direction: 'prev' | 'next';
  label: string;
}[] = [];
if (prev) cards.push({ item: prev, direction: 'prev', label: words.prev });
if (next) cards.push({ item: next, direction: 'next', label: words.next });
---

{cards.length > 0 && (
  <nav class="adjacent-nav" aria-label={words.heading}>
    <div class="adjacent-heading">
      <span>{words.heading}</span>
      <span class="adjacent-heading-line" aria-hidden="true"></span>
      <span class="adjacent-count">{String(cards.length).padStart(2, '0')}</span>
    </div>

    <div class="adjacent-grid">
      {cards.map(({ item, direction, label }) => (
        <a
          class:list={[
            'adjacent-card',
            direction === 'prev' ? 'adjacent-card--prev' : 'adjacent-card--next',
          ]}
          href={item.href}
          data-adjacent-card
        >
          <span class="adjacent-art" aria-hidden="true">
            {item.image ? (
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="adjacent-art-fallback">
                <span class="adjacent-art-orbit"></span>
                <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 8h22l8 8v40H17z" />
                  <path d="M39 8v9h8M23 28h18M23 35h18M23 42h12" />
                </svg>
              </span>
            )}
          </span>

          <span class="adjacent-content">
            <span class="adjacent-overline">
              <span class="adjacent-index">{direction === 'prev' ? '01' : '02'}</span>
              <span class="adjacent-direction">{label}</span>
            </span>

            <span class="adjacent-copy">
              <span class="adjacent-title">{item.title}</span>
              {item.description && (
                <span class="adjacent-description">{item.description}</span>
              )}
            </span>

            <span class="adjacent-bottom">
              <span class="adjacent-meta">
                {item.category && <span class="adjacent-category">{item.category}</span>}
                {item.date && <time datetime={item.datetime}>{item.date}</time>}
              </span>
              <span class="adjacent-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12h16m-6-6 6 6-6 6" />
                </svg>
              </span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </nav>
)}

<script>
  function bindAdjacentSpotlights() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('[data-adjacent-card]').forEach((card) => {
      if (card.dataset.spotlightReady) return;
      card.dataset.spotlightReady = 'true';
      card.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', String(event.clientX - rect.left) + 'px');
        card.style.setProperty('--spot-y', String(event.clientY - rect.top) + 'px');
      });
    });
  }

  bindAdjacentSpotlights();
  document.addEventListener('astro:page-load', bindAdjacentSpotlights);
</script>

<style>
  .adjacent-heading {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .adjacent-heading-line {
    width: min(6rem, 18vw);
    height: 1px;
    background: var(--border);
  }

  .adjacent-count {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .adjacent-grid {
    display: flex;
    gap: 1rem;
  }

  .adjacent-card {
    --card-tone: var(--sky);
    --spot-x: 50%;
    --spot-y: 50%;
    position: relative;
    display: block;
    flex: 1 1 0;
    min-width: 0;
    min-height: 250px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow);
    isolation: isolate;
    transition:
      flex-grow 440ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .adjacent-card--next {
    --card-tone: var(--hover);
  }

  .adjacent-card::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: radial-gradient(
      360px circle at var(--spot-x) var(--spot-y),
      color-mix(in srgb, var(--card-tone) 19%, transparent),
      transparent 70%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .adjacent-card::after {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--card-tone), transparent 75%);
    content: '';
    transform: scaleX(0.24);
    transform-origin: left;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .adjacent-grid:hover .adjacent-card,
  .adjacent-grid:focus-within .adjacent-card {
    flex-grow: 0.88;
  }

  .adjacent-grid .adjacent-card:hover,
  .adjacent-grid .adjacent-card:focus-visible {
    flex-grow: 1.16;
    border-color: color-mix(in srgb, var(--card-tone) 55%, var(--border));
    box-shadow: var(--shadow-strong);
    transform: translateY(-4px);
  }

  .adjacent-card:hover::before,
  .adjacent-card:focus-visible::before {
    opacity: 1;
  }

  .adjacent-card:hover::after,
  .adjacent-card:focus-visible::after {
    transform: scaleX(1);
  }

  .adjacent-card:focus-visible {
    outline: 2px solid var(--card-tone);
    outline-offset: 3px;
  }

  .adjacent-art {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: 0;
    width: 47%;
    opacity: 0.8;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 48%);
    mask-image: linear-gradient(90deg, transparent, #000 48%);
  }

  .adjacent-art img,
  .adjacent-art-fallback {
    width: 100%;
    height: 100%;
  }

  .adjacent-art img {
    display: block;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .adjacent-card:hover .adjacent-art img,
  .adjacent-card:focus-visible .adjacent-art img {
    transform: scale(1.08);
  }

  .adjacent-art-fallback {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 78% 30%, color-mix(in srgb, var(--card-tone) 28%, transparent), transparent 42%),
      repeating-linear-gradient(135deg, transparent 0 17px, color-mix(in srgb, var(--card-tone) 10%, transparent) 18px 19px),
      var(--surface-2);
    color: var(--card-tone);
  }

  .adjacent-art-fallback svg {
    position: relative;
    width: 74px;
    height: 74px;
    opacity: 0.68;
    transform: rotate(8deg);
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .adjacent-card:hover .adjacent-art-fallback svg,
  .adjacent-card:focus-visible .adjacent-art-fallback svg {
    transform: rotate(0deg) translateY(-4px);
  }

  .adjacent-art-orbit {
    position: absolute;
    width: 178px;
    height: 178px;
    border: 1px solid color-mix(in srgb, var(--card-tone) 35%, transparent);
    border-radius: 50%;
    transform: translate(27%, 15%);
  }

  .adjacent-art-orbit::after {
    position: absolute;
    top: 18px;
    right: 28px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--card-tone);
    content: '';
  }

  .adjacent-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 250px;
    padding: clamp(1.1rem, 2vw, 1.45rem);
    color: var(--text);
  }

  .adjacent-overline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    color: var(--card-tone);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .adjacent-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.76;
  }

  .adjacent-index::after {
    padding-left: 0.6rem;
    color: var(--text-faint);
    content: '/';
  }

  .adjacent-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: min(78%, 28rem);
    min-width: 0;
  }

  .adjacent-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text);
    font-size: clamp(1.17rem, 2vw, 1.47rem);
    font-weight: 750;
    line-height: 1.32;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    transition: color var(--transition);
  }

  .adjacent-card:hover .adjacent-title,
  .adjacent-card:focus-visible .adjacent-title {
    color: var(--card-tone);
  }

  .adjacent-description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-soft);
    font-size: 0.83rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .adjacent-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .adjacent-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  .adjacent-category {
    max-width: 8.5rem;
    padding: 0.14rem 0.52rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--card-tone) 34%, var(--border));
    border-radius: 999px;
    color: var(--card-tone);
    font-family: var(--font-sans);
    font-weight: 650;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .adjacent-meta time {
    white-space: nowrap;
  }

  .adjacent-arrow {
    display: grid;
    flex: none;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--card-tone) 46%, var(--border));
    border-radius: 50%;
    background: color-mix(in srgb, var(--card-tone) 13%, var(--surface));
    color: var(--card-tone);
    transition: transform 280ms ease, background-color 280ms ease, color 280ms ease;
  }

  .adjacent-arrow svg {
    width: 1.14rem;
    height: 1.14rem;
  }

  .adjacent-card--prev .adjacent-arrow svg {
    transform: rotate(180deg);
  }

  .adjacent-card:hover .adjacent-arrow,
  .adjacent-card:focus-visible .adjacent-arrow {
    background: var(--card-tone);
    color: var(--surface);
    transform: translateX(3px);
  }

  .adjacent-card--prev:hover .adjacent-arrow,
  .adjacent-card--prev:focus-visible .adjacent-arrow {
    transform: translateX(-3px);
  }

  @media (max-width: 700px) {
    .adjacent-grid {
      flex-direction: column;
    }

    .adjacent-card,
    .adjacent-content {
      min-height: 205px;
    }

    .adjacent-card {
      flex: none;
    }

    .adjacent-copy {
      width: min(80%, 31rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .adjacent-card,
    .adjacent-card::before,
    .adjacent-card::after,
    .adjacent-art img,
    .adjacent-art-fallback svg,
    .adjacent-title,
    .adjacent-arrow {
      transition: none;
    }

    .adjacent-card:hover,
    .adjacent-card:focus-visible {
      transform: none;
    }
  }
</style>
