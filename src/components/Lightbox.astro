---
// 全局灯箱:点击任意 `.photo-item` 图片全屏查看,支持前后切换、键盘、关闭。
// 挂在 BaseLayout 上,相册墙与作品集详情共用。
---

<div class="lightbox" data-lightbox hidden>
  <button class="lb-close" type="button" data-lb-close aria-label="Close">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 5 10 10m0-10L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  </button>
  <button class="lb-prev" type="button" data-lb-prev aria-label="Previous">
    <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <figure class="lb-stage">
    <img class="lb-img" data-lb-img src="" alt="" />
    <figcaption class="lb-caption" data-lb-caption></figcaption>
  </figure>
  <button class="lb-next" type="button" data-lb-next aria-label="Next">
    <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  if (lightbox && lightbox.dataset.ready !== 'true') {
    lightbox.dataset.ready = 'true';

    const img = lightbox.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = lightbox.querySelector<HTMLElement>('[data-lb-caption]');
    const closeBtn = lightbox.querySelector<HTMLButtonElement>('[data-lb-close]');
    const prevBtn = lightbox.querySelector<HTMLButtonElement>('[data-lb-prev]');
    const nextBtn = lightbox.querySelector<HTMLButtonElement>('[data-lb-next]');

    let items: { src: string; alt: string }[] = [];
    let current = 0;

    const collect = () =>
      [...document.querySelectorAll<HTMLImageElement>('.photo-item')].map((el) => ({
        src: el.currentSrc || el.src,
        alt: el.alt || '',
      }));

    const show = (index: number) => {
      if (items.length === 0) return;
      current = (index + items.length) % items.length;
      img!.src = items[current]!.src;
      img!.alt = items[current]!.alt;
      caption!.textContent = items.length > 1 ? `${current + 1} / ${items.length}` : '';
    };

    const open = (index: number) => {
      items = collect();
      lightbox!.hidden = false;
      document.body.style.overflow = 'hidden';
      show(index);
    };

    const close = () => {
      lightbox!.hidden = true;
      document.body.style.overflow = '';
    };

    // 绑定当前页所有照片
    const bind = () => {
      document.querySelectorAll<HTMLImageElement>('.photo-item').forEach((el) => {
        if (el.dataset.lbReady === 'true') return;
        el.dataset.lbReady = 'true';
        el.style.cursor = 'zoom-in';
        el.addEventListener('click', () => {
          const all = collect();
          const index = Math.max(0, all.findIndex((x) => x.src === (el.currentSrc || el.src)));
          open(index);
        });
      });
    };

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => show(current - 1));
    nextBtn?.addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) close();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox!.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });

    bind();
    document.addEventListener('astro:page-load', bind);
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 10, 14, 0.9);
  }
  .lightbox[hidden] {
    display: none;
  }

  .lb-stage {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    max-width: min(92vw, 1400px);
    max-height: 90vh;
  }

  .lb-img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lb-caption {
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .lb-caption:empty {
    display: none;
  }

  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .lb-close {
    top: 18px;
    right: 18px;
  }
  .lb-prev {
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .lb-prev {
      left: 8px;
    }
    .lb-next {
      right: 8px;
    }
  }
</style>
