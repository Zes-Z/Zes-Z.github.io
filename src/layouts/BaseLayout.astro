
---
import '../styles/global.css';
import '../styles/katex.css';

import Header from '../components/Header.astro';
import SearchPalette from '../components/SearchPalette.astro';
import MusicWidget from '../components/MusicWidget.astro';

import { siteConfig, siteSubtitle } from '../site.config';
import { localize } from '../i18n';
import type { Language } from '../types';
import { withBase } from '../utils/paths';

interface Props {
  lang: Language;
  title?: string;
  description?: string;

  /**
   * Omit the horizontal container so a page can go full-bleed.
   */
  fullWidth?: boolean;

  /**
   * Whether this page renders a Hero with an overlay title.
   * Only then are the web fonts loaded.
   */
  heroFont?: boolean;
}

const {
  lang,
  title,
  description,
  fullWidth = false,
  heroFont = false,
} = Astro.props;

const subtitleText = siteSubtitle();

const pageTitle = title
  ? `${title} · ${siteConfig.title}`
  : subtitleText
    ? `${siteConfig.title} — ${localize(subtitleText, lang)}`
    : siteConfig.title;

const pageDescription =
  description ?? localize(siteConfig.description, lang);
---

<!doctype html>
<html
  lang={lang}
  data-lang={lang}
  data-theme="light"
  data-code-scheme="light"
>
  <head>
    <meta charset="UTF-8" />

    <!-- Critical background colors -->
    <style
      is:inline
      set:html={`
        :root {
          --site-light-bg: ${siteConfig.theme.light.bg};
          --site-dark-bg: ${siteConfig.theme.dark.bg};
        }
      `}
    />

    <!-- Anti-flash theme bootstrap -->
    <script is:inline>
      (function () {
        try {
          var mode = localStorage.getItem('zest-theme') || 'system';

          if (mode === 'system') {
            mode = window.matchMedia(
              '(prefers-color-scheme: dark)'
            ).matches
              ? 'dark'
              : 'light';
          }

          if (mode !== 'light' && mode !== 'dark') {
            mode = 'light';
          }

          var root = document.documentElement;
          var styles = getComputedStyle(root);

          root.setAttribute('data-theme', mode);

          root.setAttribute(
            'data-code-scheme',
            mode === 'dark' ? 'dark' : 'light'
          );

          root.style.backgroundColor =
            mode === 'dark'
              ? styles.getPropertyValue('--site-dark-bg').trim()
              : styles.getPropertyValue('--site-light-bg').trim();
        } catch (e) {}
      })();
    </script>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="generator" content={Astro.generator} />

    <meta name="google" content="notranslate" />

    <meta name="description" content={pageDescription} />

    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase(siteConfig.favicon)}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title}
      href={withBase(`/${lang}/rss.xml`)}
    />

    <!-- Hero fonts: only loaded when needed -->
    {
      heroFont && (
        <link
          rel="preconnect"
          href="https://fonts.googleapis.com"
        />
      )
    }

    {
      heroFont && (
        <link
          rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin
        />
      )
    }

    {
      heroFont && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@1,500;1,600&display=swap"
        />
      )
    }

    <meta
      name="theme-color"
      content={siteConfig.theme.light.bg}
    />

    <title>{pageTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>

    <Header lang={lang} />

    <main
      id="main"
      tabindex="-1"
      class:list={{ 'main--full': fullWidth }}
    >
      {
        fullWidth
          ? <slot />
          : <div class="container-x"><slot /></div>
      }
    </main>

    <SearchPalette lang={lang} />

    <!-- Restore original MusicWidget behavior -->
    <MusicWidget />

    <!-- Copy feedback -->
    <div
      class="copy-toast"
      data-copy-toast
      role="status"
    ></div>
  </body>
</html>

<script>
  // ---------------------------------------------------
  // Code block copy
  // ---------------------------------------------------

  const copyFallback = (
    text: string,
    done: () => void
  ) => {
    const ta = document.createElement('textarea');

    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';

    document.body.appendChild(ta);
    ta.select();

    try {
      document.execCommand('copy');
      done();
    } catch {
      // Ignore fallback errors.
    }

    ta.remove();
  };

  const bindCopyButtons = () => {
    document
      .querySelectorAll<HTMLButtonElement>('[data-copy-code]')
      .forEach((btn) => {
        if (btn.dataset.ready === 'true') return;

        btn.dataset.ready = 'true';

        btn.addEventListener('click', () => {
          const block = btn.closest('.code-block');
          const code = block?.querySelector('pre code');

          if (!code) return;

          const text = code.textContent ?? '';

          const done = () => {
            btn.textContent = '✓';

            window.setTimeout(() => {
              btn.textContent = '⧉';
            }, 1400);
          };

          if (navigator.clipboard?.writeText) {
            navigator.clipboard
              .writeText(text)
              .then(done)
              .catch(() => copyFallback(text, done));
          } else {
            copyFallback(text, done);
          }
        });
      });
  };

  bindCopyButtons();

  document.addEventListener(
    'astro:page-load',
    bindCopyButtons
  );

  // ---------------------------------------------------
  // Image fallback
  // ---------------------------------------------------

  document.addEventListener(
    'error',
    (event) => {
      const el = event.target as HTMLElement | null;

      if (!el || el.tagName !== 'IMG') return;

      const img = el as HTMLImageElement;

      if (img.dataset.fallbackActive === 'true') return;

      const fallback = img.dataset.fallback;

      if (
        !fallback ||
        img.getAttribute('src') === fallback
      ) {
        return;
      }

      img.dataset.fallbackActive = 'true';
      img.src = fallback;
    },
    true
  );

  // ---------------------------------------------------
  // WeChat copy
  // ---------------------------------------------------

  let toastTimer: number | undefined;

  document.addEventListener('click', (event) => {
    const btn = (
      event.target as HTMLElement | null
    )?.closest<HTMLElement>('[data-copy-wechat]');

    if (!btn) return;

    const value = btn.dataset.copyValue ?? '';

    const toast = document.querySelector<HTMLElement>(
      '[data-copy-toast]'
    );

    void navigator.clipboard
      ?.writeText(value)
      .then(() => {
        if (!toast) return;

        toast.textContent = `已复制微信号:${value}`;

        toast.classList.add('is-visible');

        window.clearTimeout(toastTimer);

        toastTimer = window.setTimeout(() => {
          toast.classList.remove('is-visible');
        }, 1800);
      })
      .catch(() => {
        // Clipboard unavailable.
      });
  });
</script>
