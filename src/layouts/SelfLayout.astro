---
import selfCss from '../styles/self.css?inline';
import { siteConfig } from '../site.config';
import type { Language } from '../types';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
}

const {
  lang,
  title = 'About Zes',
  description = siteConfig.description,
} = Astro.props;

const pageTitle = `${title} · ${siteConfig.title}`;
---

<!doctype html>

<html lang={lang} data-lang={lang}>

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <meta
      name="description"
      content={description}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={siteConfig.favicon}
    />

    <title>{pageTitle}</title>

    <style is:inline set:html={selfCss} />

  </head>


  <body>

    <!-- =====================================================
         Main page
         ===================================================== -->

    <main
      id="main"
      class="self-page"
    >

      <slot />

    </main>


    <!-- =====================================================
         Fixed Header
         ===================================================== -->

    <header class="self-header">

      <div class="self-header-inner">

        <!-- Logo -->

        <a
          href="#home"
          class="self-logo"
          aria-label="Zes Home"
        >

          <span
            class="self-logo-icon"
            aria-hidden="true"
          >
            🐱
          </span>

          <span class="self-logo-text">
            Zes
          </span>

        </a>


        <!-- Navigation -->

        <nav
          class="self-nav"
          aria-label="Main navigation"
        >

          <a
            href="#home"
            class="self-nav-link active"
            data-section="home"
          >
            首页
          </a>

          <a
            href="#about"
            class="self-nav-link"
            data-section="about"
          >
            关于
          </a>

          <a
            href="#skills"
            class="self-nav-link"
            data-section="skills"
          >
            技能
          </a>

          <a
            href="#works"
            class="self-nav-link"
            data-section="works"
          >
            作品
          </a>

          <!-- 暂未启用的导航项 -->
          <span
            class="self-nav-link self-nav-link--placeholder"
            aria-disabled="true"
          >
            未知
          </span>

          <!-- CV 下载 -->
          <a
            href="/cv.pdf"
            class="self-nav-link self-nav-link--resume"
            download="cv.pdf"
          >
            简历
          </a>

        </nav>

      </div>

    </header>


    <!-- =====================================================
         Navigation / Section Scroll Controller
         ===================================================== -->

    <script>

      const header =
        document.querySelector<HTMLElement>(
          '.self-header'
        );


      const navLinks =
        Array.from(
          document.querySelectorAll<HTMLAnchorElement>(
            '.self-nav-link[data-section]'
          )
        );


      const sections =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            '.self-section[id]'
          )
        );


      /* =====================================================
         Scroll to section
         =====================================================

         关键：

         不再：

             sectionTop - headerHeight

         而是：

             sectionTop

         即让 section 本身真正到达 viewport 顶部。

         Header 是 fixed，
         所以它会自然覆盖在 section 上方。
      */

      function scrollToSection(
        section: HTMLElement,
        smooth = true
      ) {

        const top =
          section.getBoundingClientRect().top +
          window.scrollY;


        window.scrollTo({

          top: Math.max(0, top),

          behavior:
            smooth
              ? 'smooth'
              : 'auto',

        });

      }


      /* =====================================================
         Set active navigation
         ===================================================== */

      function setActive(
        sectionId: string
      ) {

        navLinks.forEach(
          (link) => {

            link.classList.toggle(
              'active',
              link.dataset.section === sectionId
            );

          }
        );

      }


      /* =====================================================
         Navigation click
         ===================================================== */

      navLinks.forEach(
        (link) => {

          link.addEventListener(
            'click',
            (event) => {

              const sectionId =
                link.dataset.section;

              if (!sectionId) {
                return;
              }


              const section =
                document.getElementById(
                  sectionId
                );


              if (!section) {
                return;
              }


              /*
               * 阻止浏览器默认 anchor 行为。
               */
              event.preventDefault();


              /*
               * 我们自己计算并滚动。
               */
              scrollToSection(
                section,
                true
              );


              /*
               * 修改 URL hash，
               * 但不触发浏览器默认跳转。
               */
              history.replaceState(
                null,
                '',
                `#${sectionId}`
              );


              /*
               * 立即更新导航。
               */
              setActive(
                sectionId
              );

            }
          );

        }
      );


      /* =====================================================
         Detect current section while scrolling
         ===================================================== */

      function updateActiveSection() {

        if (
          sections.length === 0
        ) {
          return;
        }


        /*
         * 当前页面滚动位置。
         */
        const scrollPosition =
          window.scrollY;


        let currentId =
          sections[0]?.id ?? 'home';


        /*
         * 用 section 的真实 document top
         * 判断当前位于哪一块。
         *
         * 不再减 Header 高度。
         */
        for (
          const section of sections
        ) {

          const sectionTop =
            section.getBoundingClientRect().top +
            window.scrollY;


          if (
            scrollPosition >=
            sectionTop - 10
          ) {

            currentId =
              section.id;

          }

        }


        setActive(
          currentId
        );

      }


      /* =====================================================
         Scroll performance
         ===================================================== */

      let ticking = false;


      window.addEventListener(
        'scroll',
        () => {

          if (ticking) {
            return;
          }


          ticking = true;


          requestAnimationFrame(
            () => {

              updateActiveSection();

              ticking = false;

            }
          );

        },
        {
          passive: true,
        }
      );


      /* =====================================================
         Initial hash
         ===================================================== */

      function handleInitialHash() {

        const hash =
          window.location.hash;


        if (!hash) {

          updateActiveSection();

          return;

        }


        const section =
          document.getElementById(
            hash.slice(1)
          );


        if (!section) {

          updateActiveSection();

          return;

        }


        /*
         * 等页面 layout 完成之后
         * 再进行第一次定位。
         */
        requestAnimationFrame(
          () => {

            requestAnimationFrame(
              () => {

                scrollToSection(
                  section,
                  false
                );

                setActive(
                  section.id
                );

              }
            );

          }
        );

      }


      /* =====================================================
         Resize
         ===================================================== */

      window.addEventListener(
        'resize',
        () => {

          updateActiveSection();

        }
      );


      /* =====================================================
         Start
         ===================================================== */

      handleInitialHash();

    </script>

  </body>

</html>